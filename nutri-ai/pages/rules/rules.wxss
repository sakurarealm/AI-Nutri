page {
  background: #f8fafc;
  height: 100%;
}

.page {
  height: 100%;
  background: linear-gradient(180deg, #ecfeff 0%, #ffffff 55%, #f8fafc 100%);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 8rpx 18rpx 0;
  background: transparent;
}

.tabs-row {
  display: flex;
  gap: 0;
  padding: 0;
}

.tab {
  flex: 1;
  padding: 16rpx 0 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-text {
  font-size: 28rpx;
  font-weight: 900;
  color: #64748b;
}

.tab.active .tab-text {
  color: #0f172a;
}

.tab-line {
  width: 46rpx;
  height: 8rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #14b8a6, #0ea5e9);
  opacity: 0;
}

.tab.active .tab-line {
  opacity: 1;
}

.content {
  flex: 1;
  height: 0;
}

.list {
  height: 100%;
  padding: 18rpx;
  box-sizing: border-box;
}

.cell {
  background: #ffffff;
  border-radius: 22rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 10rpx 40rpx rgba(15, 23, 42, 0.04);
  padding: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  box-sizing: border-box;
}

.cell:active {
  transform: scale(0.99);
}

.cell-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.arrow {
  font-size: 34rpx;
  color: #cbd5e1;
  line-height: 1;
}

.notice-card {
  background: #ffffff;
  border-radius: 26rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 18rpx 70rpx rgba(15, 23, 42, 0.08);
  padding: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
}

.notice-text {
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-time {
  font-size: 24rpx;
  font-weight: 800;
  color: #94a3b8;
  flex-shrink: 0;
}
