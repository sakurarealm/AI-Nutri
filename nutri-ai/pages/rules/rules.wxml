<view class="page">
  <view class="tabs">
    <view class="tabs-row">
      <view
        class="tab {{tabIndex === 0 ? 'active' : ''}}"
        data-index="0"
        bindtap="onTabTap"
      >
        <text class="tab-text">条款规则</text>
        <view class="tab-line"></view>
      </view>
      <view
        class="tab {{tabIndex === 1 ? 'active' : ''}}"
        data-index="1"
        bindtap="onTabTap"
      >
        <text class="tab-text">公告</text>
        <view class="tab-line"></view>
      </view>
    </view>
  </view>

  <swiper class="content" style="height: {{contentHeightPx}}px;" current="{{tabIndex}}" bindchange="onSwiperChange" duration="220">
    <swiper-item>
      <scroll-view class="list" style="height: {{contentHeightPx}}px; padding-bottom: calc(18rpx + {{safeBottomPx}}px);" scroll-y="true">
        <view class="cell" wx:for="{{ruleItems}}" wx:key="key" data-key="{{item.key}}" bindtap="onRuleTap">
          <text class="cell-title">{{item.title}}</text>
          <text class="arrow">›</text>
        </view>
      </scroll-view>
    </swiper-item>

    <swiper-item>
      <scroll-view class="list" style="height: {{contentHeightPx}}px; padding-bottom: calc(18rpx + {{safeBottomPx}}px);" scroll-y="true">
        <view class="notice-card">
          <text class="notice-text">欢迎使用AI营养师小程序！</text>
          <text class="notice-time">2026.1.1</text>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>
