.splash-container {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #ecfdf5 0%, #f0fdf4 40%, #ffffff 100%);
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.splash-container.fade-out {
  opacity: 0;
  transform: scale(1.05);
}

.splash-ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(34, 197, 94, 0.25);
  animation: splashPulse 3.2s ease-in-out infinite;
}

.ring-1 {
  width: 200rpx;
  height: 200rpx;
  animation-delay: 0s;
}

.ring-2 {
  width: 280rpx;
  height: 280rpx;
  animation-delay: 0.8s;
  border-color: rgba(34, 197, 94, 0.15);
}

.ring-3 {
  width: 360rpx;
  height: 360rpx;
  animation-delay: 1.6s;
  border-color: rgba(34, 197, 94, 0.08);
}

@keyframes splashPulse {
  0%, 100% { opacity: 0.2; transform: scale(0.9); }
  50% { opacity: 0.8; transform: scale(1.06); }
}

.splash-core {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4ade80, #22c55e);
  box-shadow: 0 12rpx 40rpx rgba(34, 197, 94, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

.splash-icon {
  font-size: 56rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.splash-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
  position: relative;
  z-index: 1;
}

.splash-sub {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 400;
  margin-bottom: 56rpx;
  position: relative;
  z-index: 1;
}

.splash-loader {
  display: flex;
  gap: 14rpx;
  position: relative;
  z-index: 1;
}

.loader-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #22c55e;
  animation: dotBounce 1.4s ease-in-out infinite;
}

.d1 { animation-delay: 0s; }
.d2 { animation-delay: 0.2s; }
.d3 { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.4; }
  40% { transform: translateY(-16rpx); opacity: 1; }
}
