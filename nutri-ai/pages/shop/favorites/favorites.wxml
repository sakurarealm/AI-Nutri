<view class="page">
  <view class="header">
    <text class="title">我的收藏</text>
    <text class="sub">收藏你常用的保健品，随时回购</text>
  </view>

  <view class="list" wx:if="{{favorites.length}}">
    <view class="card" wx:for="{{favorites}}" wx:key="id" wx:for-item="p">
      <image class="img" src="{{p.image}}" mode="aspectFill" />
      <view class="mid">
        <text class="name">{{p.name}}</text>
        <text class="spec">{{p.spec}}</text>
        <view class="price-row">
          <text class="price">￥{{p.price}}</text>
          <text class="unit">/件</text>
        </view>
      </view>
      <view class="right">
        <button class="btn btn-primary" data-id="{{p.id}}" bindtap="onBuy">去购买</button>
        <button class="btn btn-ghost" data-id="{{p.id}}" bindtap="onUnfavorite">取消收藏</button>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text class="empty-title">暂无收藏</text>
    <text class="empty-sub">去商城逛逛，把喜欢的商品收藏起来</text>
    <button class="go-shop" bindtap="goShop">去逛逛</button>
  </view>
</view>

