<view class="page">
  <view class="tabs">
    <scroll-view class="tabs-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="tabs-row">
        <view
          class="tab {{tabIndex === index ? 'active' : ''}}"
          wx:for="{{tabs}}"
          wx:key="key"
          data-index="{{index}}"
          bindtap="onTabTap"
        >
          <text class="tab-text">{{item.label}}</text>
          <view class="tab-line"></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <swiper class="content" current="{{tabIndex}}" bindchange="onSwiperChange" duration="220">
    <swiper-item wx:for="{{tabPages}}" wx:key="key" wx:for-item="page">
      <scroll-view class="list" scroll-y>
        <view class="order-card" wx:for="{{page.orders}}" wx:key="id" wx:for-item="order">
          <view class="order-head">
            <view class="head-left">
              <text class="store">AI-nutri商城</text>
              <text class="sep">·</text>
              <text class="order-no">#{{order.id}}</text>
            </view>
            <text class="status status-{{order.status}}">{{order.statusText}}</text>
          </view>
          <text class="order-time">{{order.time}}</text>

          <view class="items">
            <view class="item-row" wx:for="{{order.items}}" wx:key="skuId" wx:for-item="sku">
              <image class="item-img" src="{{sku.image}}" mode="aspectFill" />
              <view class="item-mid">
                <text class="item-name">{{sku.name}}</text>
                <text class="item-spec">{{sku.spec}}</text>
              </view>
              <view class="item-right">
                <text class="item-price">￥{{sku.price}}</text>
                <text class="item-qty">x{{sku.qty}}</text>
              </view>
            </view>
          </view>

          <view class="ship-strip" wx:if="{{order.status === 'shipped' && order.shipMap}}">
            <map
              class="mini-map"
              longitude="{{order.shipMap.center.longitude}}"
              latitude="{{order.shipMap.center.latitude}}"
              scale="11"
              markers="{{order.shipMap.markers}}"
              polyline="{{order.shipMap.polyline}}"
              enable-zoom="{{false}}"
              enable-scroll="{{false}}"
              enable-rotate="{{false}}"
              show-location="{{false}}"
            />
            <view class="ship-right">
              <text class="ship-title">运输中</text>
              <text class="ship-sub">{{order.shipMap.caption}}</text>
            </view>
          </view>

          <view class="order-foot">
            <text class="total">共 {{order.totalQty}} 件 · 合计 <text class="total-amt">￥{{order.totalAmount}}</text></text>
            <view class="actions">
              <button
                wx:if="{{order.secondaryAction}}"
                class="btn btn-ghost"
                data-id="{{order.id}}"
                data-action="{{order.secondaryAction.key}}"
                bindtap="onOrderAction"
              >
                {{order.secondaryAction.text}}
              </button>
              <button
                wx:if="{{order.primaryAction}}"
                class="btn btn-primary"
                data-id="{{order.id}}"
                data-action="{{order.primaryAction.key}}"
                bindtap="onOrderAction"
              >
                {{order.primaryAction.text}}
              </button>
            </view>
          </view>
        </view>

        <view class="empty" wx:if="{{page.empty}}">
          <text class="empty-title">暂无订单</text>
          <text class="empty-sub">去商城挑选适合你的营养补充方案</text>
          <button class="go-shop" bindtap="goShop">去逛逛</button>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>
