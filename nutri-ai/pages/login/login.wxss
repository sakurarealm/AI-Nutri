/* 页面容器 */
.login-page {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: #ffffff;
  color: #0f172a;
}

.onboard {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 80rpx) 40rpx calc(env(safe-area-inset-bottom) + 260rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: stretch;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  margin-bottom: 68rpx;
}

.brand-mark {
  width: 220rpx;
  height: 220rpx;
  border-radius: 9999rpx;
  background: #2aabee;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 50rpx rgba(42, 171, 238, 0.25);
}

.brand-mark-img {
  width: 120rpx;
  height: 120rpx;
}

.brand-name {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

/* 返回按钮 */
.back-button {
  position: fixed;
  top: 60rpx;
  left: 30rpx;
  z-index: 1000;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.back-button:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.15);
}

.back-icon {
  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

/* 欢迎容器 */
.welcome-container {
  width: 100%;
  height: 100vh;
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* Hero Section - 全新设计 */
.hero-section {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0 80rpx;
  overflow: hidden;
}

.hero-background {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  overflow: hidden;
}

/* 动态网格背景 */
.gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 20% 30%, rgba(16, 185, 129, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(52, 211, 153, 0.12) 0%, transparent 50%),
    linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 41, 59, 0.95) 100%);
}

/* 3D浮动球体 */
.decor-blobs {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.4;
  animation: float3d 15s ease-in-out infinite;
}

.blob-1 {
  top: 10%;
  left: -10%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(16,185,129,0.6), rgba(52,211,153,0.3));
  animation-delay: 0s;
}

.blob-2 {
  bottom: 15%;
  right: -12%;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(52,211,153,0.5), rgba(167,243,208,0.3));
  animation-delay: 5s;
}

.blob-3 {
  top: 50%;
  right: 15%;
  width: 350rpx;
  height: 350rpx;
  background: radial-gradient(circle, rgba(167,243,208,0.4), rgba(16,185,129,0.2));
  animation-delay: 10s;
}

@keyframes float3d {
  0%, 100% { 
    transform: translate3d(0, 0, 0) scale(1); 
  }
  33% { 
    transform: translate3d(30rpx, -40rpx, 0) scale(1.1); 
  }
  66% { 
    transform: translate3d(-25rpx, 30rpx, 0) scale(0.95); 
  }
}

/* 粒子效果装饰 */
.floating-elements {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.float-element {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  opacity: 0.08;
  animation: particleFloat 20s ease-in-out infinite;
}

.float-element image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.element-1 {
  top: 15%;
  left: 8%;
  animation-delay: 0s;
}

.element-2 {
  top: 65%;
  right: 12%;
  animation-delay: 5s;
}

.element-3 {
  bottom: 25%;
  left: 15%;
  animation-delay: 10s;
}

.element-4 {
  top: 45%;
  right: 25%;
  animation-delay: 15s;
}

@keyframes particleFloat {
  0%, 100% { 
    transform: translateY(0px) rotate(0deg); 
    opacity: 0.08;
  }
  50% { 
    transform: translateY(-40px) rotate(180deg); 
    opacity: 0.15;
  }
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  width: 100%;
  max-width: 640rpx;
}

/* 3D Logo设计 */
.brand-logo {
  position: relative;
  margin-bottom: 60rpx;
  display: flex;
  justify-content: center;
  perspective: 1000px;
}

.logo-circle {
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 249, 255, 0.9) 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 25rpx 70rpx rgba(16, 185, 129, 0.3),
    0 10rpx 30rpx rgba(0, 0, 0, 0.2),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.8);
  position: relative;
  z-index: 2;
  transform-style: preserve-3d;
  animation: logo3d 6s ease-in-out infinite;
  border: 2rpx solid rgba(16, 185, 129, 0.3);
}

@keyframes logo3d {
  0%, 100% { transform: rotateY(0deg) rotateX(0deg); }
  50% { transform: rotateY(10deg) rotateX(5deg); }
}

.logo-circle image {
  width: 100rpx;
  height: 100rpx;
  object-fit: contain;
}

.logo-glow {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.4) 0%, transparent 70%);
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation: pulse 3s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { 
    transform: translate(-50%, -50%) scale(1); 
    opacity: 0.5; 
  }
  50% { 
    transform: translate(-50%, -50%) scale(1.15); 
    opacity: 0.8; 
  }
}

/* Hero布局 */
.hero-layout {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  margin-bottom: 60rpx;
}

/* 玻璃态主卡片 */
.hero-card {
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.1) 0%, 
    rgba(255, 255, 255, 0.05) 100%);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  box-shadow: 
    0 20rpx 60rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.3);
  position: relative;
  overflow: hidden;
}

.hero-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, 
    transparent, 
    rgba(16, 185, 129, 0.8), 
    rgba(52, 211, 153, 0.8), 
    transparent);
}

.hero-text {
  margin-bottom: 50rpx;
}

.hero-title {
  display: block;
  font-size: 72rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #ffffff 0%, #d1fae5 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.hero-subtitle {
  display: block;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 30rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.hero-description {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.8;
  max-width: 540rpx;
  margin: 0 auto;
}

/* AI对话气泡 - 全新设计 */
.chat-bubbles {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: flex-start;
}

.bubble {
  background: linear-gradient(135deg, 
    rgba(16, 185, 129, 0.15) 0%, 
    rgba(52, 211, 153, 0.1) 100%);
  backdrop-filter: blur(10px);
  color: rgba(255, 255, 255, 0.95);
  padding: 24rpx 32rpx;
  border-radius: 24rpx 24rpx 24rpx 4rpx;
  border: 1px solid rgba(16, 185, 129, 0.3);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  font-size: 26rpx;
  max-width: 500rpx;
  position: relative;
  animation: bubbleIn 0.6s ease-out backwards;
}

.bubble::before {
  content: '';
  position: absolute;
  left: -8rpx;
  bottom: 0;
  width: 16rpx;
  height: 16rpx;
  background: linear-gradient(135deg, 
    rgba(16, 185, 129, 0.15) 0%, 
    transparent 100%);
  border-left: 1px solid rgba(16, 185, 129, 0.3);
  border-bottom: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: 0 0 0 4rpx;
}

@keyframes bubbleIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx) translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0) translateY(0);
  }
}

.bubble-1 { animation-delay: 0.2s; }
.bubble-2 { animation-delay: 0.4s; }
.bubble-3 { animation-delay: 0.6s; }

/* 功能快捷导航 - 横向滚动 */
.feature-rail {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 0;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.feature-rail::-webkit-scrollbar {
  display: none;
}

.rail-chip {
  min-width: 240rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.12) 0%, 
    rgba(255, 255, 255, 0.06) 100%);
  backdrop-filter: blur(15px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  box-shadow: 
    0 10rpx 30rpx rgba(0, 0, 0, 0.2),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.2);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
}

.rail-chip:active {
  transform: translateY(-4rpx);
  box-shadow: 
    0 12rpx 40rpx rgba(16, 185, 129, 0.3),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.2);
  border-color: rgba(16, 185, 129, 0.5);
}

.rail-chip image {
  width: 40rpx;
  height: 40rpx;
  object-fit: contain;
}

.rail-title { 
  font-size: 28rpx; 
  color: rgba(255, 255, 255, 0.95); 
  font-weight: 600;
  white-space: nowrap;
}

/* 数据统计卡片 */
.hero-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.08) 0%, 
    rgba(255, 255, 255, 0.03) 100%);
  backdrop-filter: blur(15px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 28rpx;
  padding: 36rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.25);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-number {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #ffffff 0%, #d1fae5 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: linear-gradient(180deg, 
    transparent, 
    rgba(255, 255, 255, 0.3), 
    transparent);
  margin: 0 30rpx;
}

.intro-cards {
  width: 750rpx;
  margin-left: -40rpx;
  margin-right: -40rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.intro-swiper {
  height: 320rpx;
  width: 100%;
  margin-left: 0;
}

.intro-illustration-stage {
  width: 100%;
  height: 360rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.intro-svg-wrap {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 320rpx;
  height: 320rpx;
  transform: translate(-50%, -50%);
  opacity: 1;
}

.intro-svg-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.z0 { z-index: 0; }
.z1 { z-index: 1; }
.z2 { z-index: 2; }
.z3 { z-index: 3; }

.svg-out {
  animation: svgOut 260ms ease-in both;
}

.svg-in {
  animation-duration: 420ms;
  animation-timing-function: cubic-bezier(0.2, 0.9, 0.2, 1);
  animation-fill-mode: both;
}

.svg-in.to-0 { animation-name: svgInPop; }
.svg-in.to-1 { animation-name: svgInLeft; }
.svg-in.to-2 { animation-name: svgInDown; }
.svg-in.to-3 { animation-name: svgInRight; }
.svg-in.to-4 { animation-name: svgInUp; }

.idle-greet { transform-origin: 70% 42%; }
.idle-greet.phase-enter { animation: greetEnter 760ms cubic-bezier(0.2, 0.9, 0.2, 1) both; }
.idle-greet.phase-loop { animation: greetLoop 2.1s cubic-bezier(0.4, 0, 0.2, 1) infinite; }

.idle-diet-food { transform-origin: 50% 70%; }
.idle-diet-food.phase-enter { animation: dietFoodEnter 980ms cubic-bezier(0.2, 0.9, 0.2, 1) both; }
.idle-diet-food.phase-loop { animation: dietFoodLoop 2.9s ease-in-out infinite; }

.idle-diet-cup { transform-origin: 50% 70%; }
.idle-diet-cup.phase-enter { animation: dietCupEnter 980ms cubic-bezier(0.2, 0.9, 0.2, 1) both; }
.idle-diet-cup.phase-loop { animation: dietCupLoop 2.9s ease-in-out infinite; }

.idle-record-pen { transform-origin: 76% 28%; }
.idle-record-pen.phase-enter { animation: recordPenEnter 1000ms cubic-bezier(0.2, 0.9, 0.2, 1) both; }
.idle-record-pen.phase-loop { animation: recordPenLoop 1.85s ease-in-out infinite; }

.idle-record-lines { transform-origin: 50% 70%; }
.idle-record-lines.phase-enter { animation: recordLinesEnter 900ms ease-out both; }
.idle-record-lines.phase-loop { animation: recordLinesLoop 1.8s ease-in-out infinite; }

.idle-heart-a { transform-origin: 35% 48%; }
.idle-heart-a.phase-enter { animation: heartEnter 900ms ease-out both; }
.idle-heart-a.phase-loop { animation: heartALoop 2.05s ease-in-out infinite; }

.idle-heart-b { transform-origin: 60% 48%; }
.idle-heart-b.phase-enter { animation: heartEnter 900ms ease-out both; }
.idle-heart-b.phase-loop { animation: heartBLoop 2.05s ease-in-out infinite; }

.idle-flex { transform-origin: 55% 65%; }
.idle-flex.phase-enter { animation: flexEnter 880ms cubic-bezier(0.2, 0.9, 0.2, 1) both; }
.idle-flex.phase-loop { animation: flexLoop 2.1s ease-in-out infinite; }

.intro-card {
  height: 100%;
  border-radius: 0;
  padding: 0 64rpx;
  box-sizing: border-box;
  background: transparent;
  border: none;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
  transform: none;
  opacity: 1;
  transition: none;
  position: relative;
  overflow: visible;
}

.intro-card.active {
  opacity: 1;
}

.intro-title {
  font-size: 68rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #000000;
  line-height: 1.1;
}

.intro-desc {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.55;
  color: #000000;
  text-align: center;
  max-width: 640rpx;
  white-space: pre-line;
}

.intro-dots {
  margin-top: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.16);
  transition: width 320ms cubic-bezier(0.2, 0.8, 0.2, 1), background 320ms ease;
}

.dot.on {
  width: 28rpx;
  background: rgba(42, 171, 238, 0.95);
}

@keyframes svgOut {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -52%) scale(0.98); }
}

@keyframes svgInPop {
  0% { opacity: 0; transform: translate(-50%, -46%) scale(0.86); }
  100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

@keyframes svgInLeft {
  0% { opacity: 0; transform: translate(-50%, -50%) translateX(-34rpx) scale(0.94); }
  100% { opacity: 1; transform: translate(-50%, -50%) translateX(0) scale(1); }
}

@keyframes svgInRight {
  0% { opacity: 0; transform: translate(-50%, -50%) translateX(34rpx) scale(0.94); }
  100% { opacity: 1; transform: translate(-50%, -50%) translateX(0) scale(1); }
}

@keyframes svgInUp {
  0% { opacity: 0; transform: translate(-50%, -50%) translateY(-26rpx) scale(0.94); }
  100% { opacity: 1; transform: translate(-50%, -50%) translateY(0) scale(1); }
}

@keyframes svgInDown {
  0% { opacity: 0; transform: translate(-50%, -50%) translateY(26rpx) scale(0.94); }
  100% { opacity: 1; transform: translate(-50%, -50%) translateY(0) scale(1); }
}

@keyframes greetEnter {
  0% { opacity: 0; transform: translateY(12rpx) rotate(-6deg) scale(0.98); }
  55% { opacity: 1; transform: translateY(0) rotate(5deg) scale(1.01); }
  100% { opacity: 1; transform: translateY(0) rotate(0deg) scale(1); }
}

@keyframes greetLoop {
  0% { transform: rotate(0deg); }
  18% { transform: rotate(0deg); }
  30% { transform: rotate(-8deg); }
  38% { transform: rotate(6deg); }
  46% { transform: rotate(-6deg); }
  54% { transform: rotate(4deg); }
  62% { transform: rotate(0deg); }
  100% { transform: rotate(0deg); }
}

@keyframes dietFoodEnter {
  0% { opacity: 0; transform: translateX(-90rpx) translateY(-64rpx) scale(0.92); }
  55% { opacity: 1; transform: translateX(6rpx) translateY(6rpx) scale(1.03); }
  100% { opacity: 1; transform: translateX(0) translateY(0) scale(1); }
}

@keyframes dietCupEnter {
  0% { opacity: 0; transform: translateX(94rpx) translateY(-70rpx) scale(0.92); }
  55% { opacity: 1; transform: translateX(-6rpx) translateY(6rpx) scale(1.03); }
  100% { opacity: 1; transform: translateX(0) translateY(0) scale(1); }
}

@keyframes dietFoodLoop {
  0% { opacity: 0; transform: translateX(-92rpx) translateY(-70rpx) rotate(-8deg) scale(0.92); }
  12% { opacity: 0; transform: translateX(-92rpx) translateY(-70rpx) rotate(-8deg) scale(0.92); }
  38% { opacity: 1; transform: translateX(6rpx) translateY(8rpx) rotate(2deg) scale(1.03); }
  52% { opacity: 1; transform: translateX(0) translateY(0) rotate(0deg) scale(1); }
  82% { opacity: 1; transform: translateX(0) translateY(0) rotate(0deg) scale(1); }
  92% { opacity: 0; transform: translateX(-92rpx) translateY(-70rpx) rotate(-8deg) scale(0.92); }
  100% { opacity: 0; transform: translateX(-92rpx) translateY(-70rpx) rotate(-8deg) scale(0.92); }
}

@keyframes dietCupLoop {
  0% { opacity: 0; transform: translateX(94rpx) translateY(-76rpx) rotate(10deg) scale(0.92); }
  18% { opacity: 0; transform: translateX(94rpx) translateY(-76rpx) rotate(10deg) scale(0.92); }
  44% { opacity: 1; transform: translateX(-6rpx) translateY(10rpx) rotate(-2deg) scale(1.03); }
  58% { opacity: 1; transform: translateX(0) translateY(0) rotate(0deg) scale(1); }
  82% { opacity: 1; transform: translateX(0) translateY(0) rotate(0deg) scale(1); }
  92% { opacity: 0; transform: translateX(94rpx) translateY(-76rpx) rotate(10deg) scale(0.92); }
  100% { opacity: 0; transform: translateX(94rpx) translateY(-76rpx) rotate(10deg) scale(0.92); }
}

@keyframes recordPenEnter {
  0% { opacity: 0; transform: translateX(26rpx) translateY(-10rpx) rotate(10deg) scale(0.98); }
  45% { opacity: 1; transform: translateX(0) translateY(0) rotate(-4deg) scale(1); }
  70% { opacity: 1; transform: translateX(-6rpx) translateY(4rpx) rotate(2deg) scale(1); }
  100% { opacity: 1; transform: translateX(0) translateY(0) rotate(0deg) scale(1); }
}

@keyframes recordPenLoop {
  0% { transform: translateX(0) translateY(0) rotate(0deg); }
  20% { transform: translateX(-6rpx) translateY(4rpx) rotate(-2.2deg); }
  40% { transform: translateX(-12rpx) translateY(2rpx) rotate(1.2deg); }
  60% { transform: translateX(-18rpx) translateY(5rpx) rotate(-1.6deg); }
  80% { transform: translateX(-10rpx) translateY(3rpx) rotate(1.0deg); }
  100% { transform: translateX(0) translateY(0) rotate(0deg); }
}

@keyframes recordLinesEnter {
  0% { opacity: 0; transform: translateY(6rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes recordLinesLoop {
  0% { opacity: 0.78; }
  40% { opacity: 1; }
  100% { opacity: 0.78; }
}

@keyframes heartEnter {
  0% { opacity: 0; transform: scale(0.92) translateY(10rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes heartALoop {
  0% { transform: translateX(0) scale(1); }
  28% { transform: translateX(-5rpx) scale(1.04); }
  55% { transform: translateX(-2rpx) scale(0.99); }
  100% { transform: translateX(0) scale(1); }
}

@keyframes heartBLoop {
  0% { transform: translateX(0) scale(1); }
  28% { transform: translateX(5rpx) scale(1.03); }
  55% { transform: translateX(2rpx) scale(0.99); }
  100% { transform: translateX(0) scale(1); }
}

@keyframes flexEnter {
  0% { opacity: 0; transform: scale(0.92) rotate(-6deg) translateY(10rpx); }
  50% { opacity: 1; transform: scale(1.06) rotate(3deg) translateY(-2rpx); }
  100% { opacity: 1; transform: scale(1) rotate(0deg) translateY(0); }
}

@keyframes flexLoop {
  0% { transform: scale(1) translateY(0); }
  35% { transform: scale(1.055) translateY(-3rpx); }
  65% { transform: scale(1.01) translateY(0); }
  100% { transform: scale(1) translateY(0); }
}

.onboard-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: auto;
  padding: 0 24rpx calc(env(safe-area-inset-bottom) + 56rpx);
  box-sizing: border-box;
  background: #ffffff;
}

.primary-cta {
  width: 100% !important;
  max-width: none !important;
  box-sizing: border-box;
  height: 104rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #1fa6ea 0%, #2aabee 45%, #35c7f3 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 40rpx rgba(42, 171, 238, 0.30);
  position: relative;
  overflow: hidden;
}

.primary-cta:active {
  transform: scale(0.99);
  opacity: 0.95;
}

.primary-cta::after {
  border: none;
}

.primary-cta::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 160%;
  height: 100%;
  transform: translateX(-120%) skewX(-20deg);
  background: linear-gradient(90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0) 36%,
    rgba(255, 255, 255, 0.45) 50%,
    rgba(255, 255, 255, 0) 64%,
    rgba(255, 255, 255, 0) 100%);
  opacity: 0.75;
  filter: blur(1rpx);
  animation: primaryCtaShimmer 2.4s ease-in-out infinite;
  pointer-events: none;
}

@keyframes primaryCtaShimmer {
  0% { transform: translateX(-120%) skewX(-20deg); }
  55% { transform: translateX(120%) skewX(-20deg); }
  100% { transform: translateX(120%) skewX(-20deg); }
}

/* 功能展示区域 - 重新设计 */
