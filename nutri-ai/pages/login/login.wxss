/* 3D卡片效果 */
.feature-card {
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.1) 0%, 
    rgba(255, 255, 255, 0.05) 100%);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 36rpx;
  padding: 48rpx;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  box-shadow: 0 15rpx 50rpx rgba(0, 0, 0, 0.3);
}

.feature-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, 
    transparent, 
    rgba(16, 185, 129, 0.8), 
    rgba(52, 211, 153, 0.8), 
    transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.feature-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), 
    rgba(16, 185, 129, 0.1) 0%, 
    transparent 50%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.feature-card:active {
  transform: translateY(-8rpx) scale(1.02);
  box-shadow: 0 25rpx 70rpx rgba(16, 185, 129, 0.4);
  border-color: rgba(16, 185, 129, 0.4);
}

.feature-card:active::before,
.feature-card:active::after {
  opacity: 1;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.feature-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, 
    rgba(16, 185, 129, 0.2) 0%, 
    rgba(52, 211, 153, 0.15) 100%);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(16, 185, 129, 0.25);
  position: relative;
  overflow: hidden;
}

.feature-icon-wrapper::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.2) 0%, 
    transparent 100%);
}

.feature-icon-wrapper image {
  width: 56rpx;
  height: 56rpx;
  object-fit: contain;
  position: relative;
  z-index: 1;
}

.feature-badge {
  background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
