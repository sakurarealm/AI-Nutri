page {
  background: #f8fafc;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ecfeff 0%, #ffffff 55%, #f8fafc 100%);
  padding: 24rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 26rpx;
  box-shadow: 0 16rpx 60rpx rgba(15, 23, 42, 0.06);
}

.hero-left {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 40rpx;
  font-weight: 950;
  color: #0f172a;
  display: block;
}

.sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #94a3b8;
  display: block;
}

.hero-right {
  width: 124rpx;
  height: 124rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(14, 165, 233, 0.14), rgba(20, 184, 166, 0.14));
  border: 2rpx solid rgba(14, 165, 233, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-icon {
  width: 78rpx;
  height: 78rpx;
}

.list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 22rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 40rpx rgba(15, 23, 42, 0.04);
  border: 2rpx solid rgba(15, 23, 42, 0.06);
}

.cell:active {
  transform: scale(0.99);
}

.cell.active {
  border: 2rpx solid rgba(14, 165, 233, 0.22);
  box-shadow: 0 18rpx 60rpx rgba(14, 165, 233, 0.10);
}

.cell-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.cell-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.check {
  font-size: 26rpx;
  font-weight: 900;
  color: #0ea5e9;
}

.arrow {
  font-size: 34rpx;
  color: #cbd5e1;
  line-height: 1;
}

