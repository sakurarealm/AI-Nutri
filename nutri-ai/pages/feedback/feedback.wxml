<view class="page">
  <view class="hero">
    <view class="hero-left">
      <text class="title">帮助我们做得更好</text>
      <text class="sub">请选择一个问题类型</text>
    </view>
    <view class="hero-right">
      <image class="hero-icon" src="/static/邮件.png" mode="aspectFit" />
    </view>
  </view>

  <view class="list">
    <view
      class="cell {{selectedKey === item.key ? 'active' : ''}}"
      wx:for="{{types}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTypeTap"
    >
      <text class="cell-title">{{item.label}}</text>
      <view class="cell-right">
        <text wx:if="{{selectedKey === item.key}}" class="check">✓</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>

