page {
  background: #f8fafc;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ecfeff 0%, #ffffff 55%, #f8fafc 100%);
  padding: 28rpx;
  box-sizing: border-box;
}

.banner {
  width: 100%;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(148, 163, 184, 0.18);
  border: 2rpx solid rgba(148, 163, 184, 0.18);
  box-sizing: border-box;
}

.banner-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #64748b;
  line-height: 1.5;
}

.card {
  margin-top: 18rpx;
  background: #ffffff;
  border-radius: 30rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 18rpx 70rpx rgba(15, 23, 42, 0.08);
  padding: 34rpx;
  box-sizing: border-box;
  min-height: 66vh;
  display: flex;
  flex-direction: column;
}

.row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 900;
  color: #0f172a;
  flex-shrink: 0;
}

.value {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-stars {
  margin-top: 26rpx;
  align-items: center;
  justify-content: space-between;
}

.stars {
  display: flex;
  gap: 8rpx;
  align-items: center;
  justify-content: flex-end;
}

.star {
  font-size: 52rpx;
  color: rgba(148, 163, 184, 0.6);
  line-height: 1;
  transform: translateY(2rpx);
}

.star.on {
  color: #f59e0b;
  text-shadow: 0 10rpx 30rpx rgba(245, 158, 11, 0.25);
}

.input-wrap {
  margin-top: 26rpx;
  background: rgba(241, 245, 249, 0.9);
  border-radius: 26rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  padding: 22rpx 22rpx 14rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 340rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.5;
}

.count {
  margin-top: 10rpx;
  display: block;
  text-align: right;
  font-size: 22rpx;
  font-weight: 700;
  color: #94a3b8;
}

.divider {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: rgba(148, 163, 184, 0.25);
}

.divider-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #94a3b8;
  white-space: nowrap;
}

.picker-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 20rpx;
  border-radius: 26rpx;
  background: #ffffff;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.picker-label {
  font-size: 28rpx;
  font-weight: 900;
  color: #0f172a;
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.picker-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #64748b;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  font-size: 34rpx;
  color: #cbd5e1;
  line-height: 1;
}

.submit-btn {
  margin-top: auto;
  margin-bottom: 6rpx;
  width: 100%;
  height: 98rpx;
  border-radius: 50px;
  font-size: 32rpx;
  font-weight: 950;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.submit-btn::after {
  border: none;
}

.submit-btn.off {
  background: rgba(148, 163, 184, 0.35);
  color: rgba(15, 23, 42, 0.45);
}

.submit-btn.on {
  background: linear-gradient(135deg, #14b8a6 0%, #0ea5e9 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: 0 20rpx 70rpx rgba(14, 165, 233, 0.30);
  color: #ffffff;
}
