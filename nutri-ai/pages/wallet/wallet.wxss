.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ecfeff 0%, #ffffff 55%, #f8fafc 100%);
  padding: 24rpx;
  box-sizing: border-box;
}

.balance-card {
  height: 320rpx;
  border-radius: 32rpx;
  padding: 28rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 86% 12%, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0) 48%),
    radial-gradient(circle at 18% 88%, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 45%),
    linear-gradient(135deg, #0ea5e9 0%, #14b8a6 52%, #6366f1 100%);
  box-shadow: 0 22rpx 80rpx rgba(15, 23, 42, 0.16);
}

.balance-card::before {
  content: '';
  position: absolute;
  inset: -120rpx -120rpx auto auto;
  width: 520rpx;
  height: 520rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 62%);
  transform: rotate(12deg);
  pointer-events: none;
}

.balance-card::after {
  content: '';
  position: absolute;
  left: -160rpx;
  bottom: -190rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 120rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0));
  transform: rotate(-18deg);
  pointer-events: none;
}

.balance-left {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.balance-title {
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.92);
}

.balance-amount {
  font-size: 56rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 1rpx;
  text-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.18);
}

.balance-actions {
  position: absolute;
  right: 22rpx;
  top: 42rpx;
  display: flex;
  gap: 18rpx;
  z-index: 1;
}

.card-action {
  width: 112rpx;
  padding: 16rpx 12rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-sizing: border-box;
}

.card-action-icon {
  width: 44rpx;
  height: 44rpx;
}

.card-action-text {
  font-size: 24rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.95);
}

.card-chip {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  width: 128rpx;
  height: 92rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.12));
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  z-index: 1;
  overflow: hidden;
}

.chip-line {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.18);
}

.chip-line-1 {
  top: 18rpx;
}

.chip-line-2 {
  top: 42rpx;
  opacity: 0.8;
}

.chip-line-3 {
  top: 66rpx;
  opacity: 0.6;
}

.tabs {
  margin-top: 22rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx;
  display: flex;
  gap: 8rpx;
  box-shadow: 0 16rpx 60rpx rgba(15, 23, 42, 0.06);
  border: 2rpx solid rgba(15, 23, 42, 0.06);
}

.tab {
  flex: 1;
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  color: #64748b;
}

.tab.active {
  color: #0f172a;
  background: linear-gradient(135deg, rgba(14, 165, 233, 0.12), rgba(20, 184, 166, 0.12));
  border: 2rpx solid rgba(14, 165, 233, 0.18);
}

.content-swiper {
  margin-top: 18rpx;
  height: calc(100vh - 24rpx - 320rpx - 22rpx - 84rpx - 18rpx - 24rpx);
  min-height: 520rpx;
}

.empty {
  height: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 60rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 34rpx;
  box-sizing: border-box;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
}

.empty-sub {
  font-size: 24rpx;
  font-weight: 700;
  color: #94a3b8;
  text-align: center;
}

.history-wrap {
  margin-top: 18rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 12rpx);
}

.history-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 60rpx rgba(15, 23, 42, 0.06);
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-btn::after {
  border: none;
}
