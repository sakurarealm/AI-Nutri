/* pages/aiAgent/aiAgent.wxss */

/* AI分析动画 */
.analysis-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.analysis-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.analysis-icon {
  width: 120rpx;
  height: 120rpx;
  background-image: url('/images/icon_analysis.png');
  background-size: contain;
  background-repeat: no-repeat;
  animation: pulse-fade 1.5s infinite;
}

.analysis-text {
  font-size: 28rpx;
  color: #333;
}

@keyframes pulse-fade {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.7;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 基础样式 */
page {
  background-color: #f6f7f9;
  height: 100vh;
  overflow: hidden;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f6f7f9;
}

/* 状态栏 */
.status-bar {
  width: 100%;
  background-color: #ffffff;
  flex-shrink: 0;
}

/* 头部 - 数字人常驻 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 44rpx 28rpx 20rpx;
  background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);
  flex-shrink: 0;
  position: relative;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 32rpx;
  right: 32rpx;
  height: 1rpx;
  background: linear-gradient(90deg, 
    rgba(34, 197, 94, 0) 0%, 
    rgba(34, 197, 94, 0.12) 50%, 
    rgba(34, 197, 94, 0) 100%
  );
}

.digital-human-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.dh-avatar-container {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.dh-ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(34, 197, 94, 0.3);
  animation: dhRingPulse 3s ease-in-out infinite;
}

.dh-ring-1 {
  inset: -6rpx;
  animation-delay: 0s;
}

.dh-ring-2 {
  inset: -14rpx;
  animation-delay: 1.5s;
  border-color: rgba(34, 197, 94, 0.15);
}

@keyframes dhRingPulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.08); opacity: 1; }
}

.dh-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.15);
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
}

.dh-status-dot {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #22c55e;
  border: 3rpx solid #ffffff;
  box-shadow: 0 0 8rpx rgba(34, 197, 94, 0.4);
  animation: dhStatusPulse 2s ease-in-out infinite;
}

@keyframes dhStatusPulse {
  0%, 100% { box-shadow: 0 0 6rpx rgba(34, 197, 94, 0.3); }
  50% { box-shadow: 0 0 14rpx rgba(34, 197, 94, 0.6); }
}

.dh-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.dh-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dh-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: 0.5rpx;
}

.dh-badge {
  font-size: 20rpx;
  color: #22c55e;
  background: rgba(34, 197, 94, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.dh-greeting {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 400;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-action-chip {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 1.5rpx solid rgba(230, 230, 240, 0.6);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.header-action-chip:active {
  background: rgba(34, 197, 94, 0.08);
  transform: scale(0.92);
}

.header-action-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.6;
}

/* 主容器 */
.main-container {
  flex: 1;
  min-height: 0;
  background-color: transparent;
  order: 1;
}

.top-load-indicator {
  padding: 14rpx 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-load-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.04);
  color: #666;
  font-size: 22rpx;
}

.top-load-pill.ghost {
  background: rgba(0, 0, 0, 0.02);
  color: #888;
}

.top-load-spinner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  border: 3rpx solid rgba(0, 0, 0, 0.12);
  border-top-color: rgba(0, 0, 0, 0.5);
  animation: top-load-spin 0.9s linear infinite;
}

.top-load-text {
  font-size: 22rpx;
  color: inherit;
}

@keyframes top-load-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.messages-wrapper {
