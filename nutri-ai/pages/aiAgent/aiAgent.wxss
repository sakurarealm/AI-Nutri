  background: rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #333;
}

/* 顶部缓冲区 */
.top-buffer {
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.5;
  font-size: 24rpx;
  color: #999999;
}

.top-buffer::after {
  content: '已经到顶了';
  opacity: 0;
  transition: opacity 0.3s ease;
}

/* 消息项 */
.message-item {
  margin-bottom: 32rpx;
  animation: messageIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes messageIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.user-row {
  justify-content: flex-end;
}

/* 头像 */
.message-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #f5f5f5;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 消息气泡 */
.message-bubble {
  max-width: calc(100vw - 240rpx);
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  word-break: break-word;
}

.ai-bubble {
  background-color: #f8f9fa;
  border-bottom-left-radius: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.user-bubble {
  background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.15);
}

/* 消息文本 */
.message-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #1a1a1a;
  display: block;
  white-space: pre-wrap;
}

.user-bubble .message-text {
  color: #ffffff;
}

/* 消息时间 */
.message-time {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
  opacity: 0.8;
}

.user-bubble .message-time {
  color: rgba(255, 255, 255, 0.8);
  text-align: right;
}

.bubble-action-divider {
  height: 1rpx;
  margin-top: 16rpx;
  background: rgba(0, 0, 0, 0.06);
}

.bubble-action-bar {
  display: flex;
  align-items: center;
  width: 100%;
  justify-content: flex-start;
  padding-top: 12rpx;
}

.bubble-action-left,
.bubble-action-right {
  display: flex;
  align-items: center;
}

.bubble-action-left {
  gap: 12rpx;
}

.bubble-action-right {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  justify-content: flex-end;
}

.bubble-action-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  background: #f2f3f5;
  border: 0;
  border-radius: 14rpx;
}

.bubble-action-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.bubble-action-share {
  flex: 1;
  width: auto;
  line-height: 0;
}

.bubble-action-btn::after {
  border: 0;
}

.bubble-action-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.82;
}

.bubble-action-spinner {
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  border: 3rpx solid rgba(0, 0, 0, 0.12);
  border-top-color: rgba(0, 0, 0, 0.5);
  animation: top-load-spin 0.9s linear infinite;
}

/* 对话续写推荐 */
.quick-reply-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 12rpx;
}

.quick-reply-spacer {
  width: 72rpx;
  flex-shrink: 0;
}

.quick-reply-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-reply-chip {
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(248, 250, 252, 0.98);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.quick-reply-chip:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.quick-reply-text {
  font-size: 26rpx;
  color: #111827;
  line-height: 1.25;
}

/* 加载气泡 */
.loading-bubble {
  padding: 20rpx 32rpx;
  min-width: 120rpx;
}

.pending-bubble {
  min-height: 44rpx;
  display: flex;
  align-items: center;
}

.pending-summary {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.pending-summary-title {
  font-size: 26rpx;
  line-height: 1.3;
  color: #6b7280;
}

.summary-progress-track {
  width: 360rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.08);
  overflow: hidden;
}

.summary-progress-bar {
  height: 100%;
  width: 42%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(34, 197, 94, 0.2), rgba(59, 130, 246, 0.85), rgba(168, 85, 247, 0.8), rgba(34, 197, 94, 0.2));
  animation: summaryProgress 1.5s ease-in-out infinite;
}

@keyframes summaryProgress {
  0% {
    transform: translateX(-140%);
    opacity: 0.6;
  }
  50% {
    transform: translateX(120%);
    opacity: 1;
  }
  100% {
    transform: translateX(340%);
    opacity: 0.6;
  }
}

/* 打字动画 */
.typing-dots {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 32rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #999999;
  animation: typing 1.4s infinite ease-in-out;
}

.dot:nth-child(1) {
  animation-delay: 0s;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.5;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

/* 输入栏 */
.input-bar {
  padding: 10rpx 24rpx 18rpx;
  flex-shrink: 0;
  position: fixed;
  left: 0;
  right: 0;
  z-index: 800;
  order: 2;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(32rpx);
  -webkit-backdrop-filter: blur(32rpx);
  border-top: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
}

/* 顶部操作栏 - 历史记录/电话按钮与每日总结同一行 */
.top-actions-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0;
}

.top-actions-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.top-action-chip {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border: 1rpx solid rgba(0, 0, 0, 0.10);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.top-action-chip:active {
  transform: scale(0.96);
  background-color: rgba(34, 197, 94, 0.08);
  border-color: rgba(34, 197, 94, 0.18);
}

.top-action-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  opacity: 0.8;
}

.top-action-text {
  display: flex;
  flex-direction: column;
}

.top-action-title {
  font-size: 24rpx;
  color: #111827;
  font-weight: 600;
  white-space: nowrap;
}

.manager-actions-bar {
  padding: 0 4rpx;
}

.manager-scroll {
  width: 100%;
  white-space: nowrap;
}

.manager-list {
  display: flex;
  gap: 12rpx;
  padding: 6rpx 0;
}

.manager-chip {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border: 1rpx solid rgba(0, 0, 0, 0.10);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.manager-chip:active {
  transform: scale(0.96);
  background-color: rgba(34, 197, 94, 0.08);
  border-color: rgba(34, 197, 94, 0.18);
}

.manager-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
}

.manager-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.manager-title {
  font-size: 24rpx;
  color: #111827;
  font-weight: 600;
  white-space: nowrap;
  line-height: 1;
}

.manager-sub {
  display: none;
}

/* AI电话遮罩样式 */
.call-overlay {
  position: fixed;
  z-index: 999;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #eef2ff 0%, #ffffff 100%);
  backdrop-filter: blur(16rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 24rpx;
}
.call-top {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.call-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}
.call-status {
  font-size: 26rpx;
  color: #6b7280;
}
.call-timer {
  font-size: 28rpx;
  color: #999999;
}
.call-transcript {
  width: 100%;
  max-width: 700rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}
.call-line {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.call-line.user {
  color: #0f172a;
}
.call-line.ai {
  color: #334155;
}
.call-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}
.avatar-container {
  position: relative;
  width: 360rpx;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.call-avatar {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08);
  border: 4rpx solid #ffffff;
  z-index: 1;
}
.call-avatar-video {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  z-index: 2;
}
.ring {
  position: absolute;
  border-radius: 50%;
  opacity: 0;
  transform: scale(0.8);
  border: 4rpx solid rgba(16, 185, 129, 0.18);
  z-index: 0;
}
.ring-1 { width: 340rpx; height: 340rpx; }
.ring-2 { width: 400rpx; height: 400rpx; }
.ring-3 { width: 460rpx; height: 460rpx; }
.avatar-container.speaking .ring {
  animation: pulse 1.6s infinite ease-out;
}
@keyframes pulse {
  0% { opacity: 0.0; transform: scale(0.8); }
  30% { opacity: 0.25; transform: scale(0.9); }
  60% { opacity: 0.15; transform: scale(1.0); }
  100% { opacity: 0.0; transform: scale(1.1); }
}
.spectrum {
  display: flex;
  flex-direction: column;
  gap: 0;
  align-items: center;
  margin-top: 2rpx;
}
.call-overlay .spectrum { transform: translateY(-60px); }
.call-overlay .call-center { transform: translateY(-120px); }

/* 工作流入口区域 */
.workflow-ribbon {
  position: relative;
  width: 92%;
  max-width: 700rpx;
  padding: 18rpx 20rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  overflow-x: auto;
  backdrop-filter: blur(18rpx);
}
.workflow-ribbon::before {
  content: '';
  position: absolute;
  left: 10rpx; right: 10rpx; top: 50%;
  height: 6rpx;
  transform: translateY(-50%);
  background: linear-gradient(90deg, rgba(16,185,129,0.0) 0%, rgba(16,185,129,0.45) 25%, rgba(59,130,246,0.45) 50%, rgba(139,92,246,0.45) 75%, rgba(16,185,129,0.0) 100%);
  background-size: 200% auto;
  filter: blur(10rpx);
  opacity: 0.35;
  animation: flow 5s linear infinite;
}
/* 闪烁粒子效果 */
.workflow-ribbon::after {
  content: '';
  position: absolute;
  left: 10rpx; right: 10rpx; top: 50%;
  height: 8rpx;
  transform: translateY(-50%);
  background-image: radial-gradient(circle at 10% 50%, rgba(255,255,255,0.9) 0rpx, rgba(255,255,255,0.9) 2rpx, transparent 3rpx),
                    radial-gradient(circle at 40% 50%, rgba(255,255,255,0.75) 0rpx, rgba(255,255,255,0.75) 2rpx, transparent 3rpx),
                    radial-gradient(circle at 70% 50%, rgba(255,255,255,0.9) 0rpx, rgba(255,255,255,0.9) 2rpx, transparent 3rpx);
  background-repeat: no-repeat;
  background-size: 16rpx 8rpx, 16rpx 8rpx, 16rpx 8rpx;
  animation: particles 3.8s linear infinite;
  pointer-events: none;
  opacity: 0.55;
}
@keyframes particles {
  0% { background-position: 0% 0, 30% 0, 60% 0; }
  50% { background-position: 50% 0, 80% 0, 110% 0; }
  100% { background-position: 100% 0, 130% 0, 160% 0; }
}
@keyframes flow { 0% { background-position: 0% 0; } 100% { background-position: 200% 0; } }

.workflow-chip {
  position: relative;
  min-width: 280rpx;
  max-width: 360rpx;
  height: 120rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.65) 0%, rgba(255,255,255,0.35) 100%);
  border: 1rpx solid rgba(255,255,255,0.5);
  box-shadow: 0 12rpx 36rpx rgba(0,0,0,0.12), inset 0 6rpx 10rpx rgba(255,255,255,0.18);
  display: flex;
  align-items: center;
  gap: 14rpx;
  animation: chipFloat 4.2s ease-in-out infinite;
}
.workflow-chip:active { transform: scale(0.98); }
.workflow-chip::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 24rpx;
  background: linear-gradient(120deg, rgba(255,255,255,0.28), rgba(255,255,255,0));
  filter: blur(4rpx);
  opacity: 0.65;
  pointer-events: none;
}
/* 辐射光环轻微脉动 */
.workflow-chip::before {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  border-radius: 24rpx;
  box-shadow: 0 0 0 0 rgba(59,130,246,0.12);
  animation: glowPulse 3.6s ease-in-out infinite;
  pointer-events: none;
}
@keyframes glowPulse {
  0% { box-shadow: 0 0 0 0 rgba(59,130,246,0.10); }
  50% { box-shadow: 0 0 22rpx 6rpx rgba(99,102,241,0.18); }
  100% { box-shadow: 0 0 0 0 rgba(59,130,246,0.10); }
}
@keyframes chipFloat {
  0% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
  100% { transform: translateY(0); }
}
.chip-icon { width: 56rpx; height: 56rpx; border-radius: 14rpx; }
.chip-icon { box-shadow: 0 6rpx 18rpx rgba(16,185,129,0.18); }
.chip-text { display: flex; flex-direction: column; }
.chip-title { font-size: 28rpx; color: #111827; font-weight: 600; }
.chip-sub { font-size: 22rpx; color: #6b7280; margin-top: 4rpx; }
.invert { transform: scaleY(-1); }
.center-spacer { height: 100rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }

.voice-onboarding-progress {
  width: 70vw;
  max-width: 560rpx;
}

.vob-steps-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.vob-step-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.vob-step-counter {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
  font-weight: 500;
}

.vob-bar-track {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255,255,255,0.25);
  overflow: hidden;
}

.vob-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #4ade80, #22c55e);
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
.spectrum-card { position: relative; background: none; border: none; box-shadow: none; backdrop-filter: none; padding: 0; width: 88vw; max-width: 680rpx; }
.spectrum-card::before { display: none; }
.bars {
  display: flex;
  gap: 6rpx;
  height: 80rpx;
  align-items: flex-end;
  justify-content: center;
}
.bar {
  width: 8rpx;
  height: 80rpx;
  background: linear-gradient(180deg, #34d399, #10b981);
  border-radius: 10rpx;
  transform-origin: bottom center;
  transition: transform 0.06s ease-out;
  will-change: transform;
}
/* 颜色由内联 style 设置为彩色渐变，移除默认 lane 色 */
.call-bottom {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding-bottom: 40rpx;
}
.control-bar { width: 90%; max-width: 700rpx; display: flex; justify-content: space-between; align-items: center; }
.glass-btn {
  width: 128rpx; height: 128rpx; border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.65) 0%, rgba(255,255,255,0.35) 100%);
  backdrop-filter: blur(22rpx);
  border: 1rpx solid rgba(255,255,255,0.45);
  box-shadow: 0 10rpx 36rpx rgba(0,0,0,0.12), inset 0 6rpx 10rpx rgba(255,255,255,0.18);
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.glass-btn.on { filter: saturate(1.1) contrast(1.02); }
.glass-btn.off { filter: grayscale(0.2) brightness(0.95); }
.mic-btn.on { border-color: rgba(59,130,246,0.45); }
.speaker-btn.on { border-color: rgba(16,185,129,0.45); }
.hangup-btn.glass-btn { background: linear-gradient(180deg, rgba(255,255,255,0.65) 0%, rgba(255,255,255,0.35) 100%), radial-gradient(115rpx 115rpx at 50% 50%, rgba(239,68,68,0.85) 0%, rgba(220,38,38,0.9) 100%); border: 2rpx solid rgba(255,255,255,0.7); }
.control-icon { width: 56rpx; height: 56rpx; opacity: 0.95; }
.slash { position: absolute; width: 2rpx; height: 86rpx; background: rgba(239,68,68,0.88); border-radius: 2rpx; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(45deg); }
.hangup-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(115rpx 115rpx at 50% 50%, #ef4444 0%, #dc2626 100%);
  box-shadow: 0 12rpx 28rpx rgba(239, 68, 68, 0.35), inset 0 6rpx 10rpx rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
}
.hangup-btn:active {
  transform: scale(0.96);
  filter: brightness(0.95);
}
.hangup-icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.95;
}
/* 连接加载动画 */
.connecting-loader { height: 40rpx; display: flex; align-items: center; justify-content: center; }
.loader {
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid rgba(0,0,0,0.08);
  border-top-color: #10b981;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 频谱卡片极简，无边框居中贴时长 */
.spectrum-card.minimal { background: transparent !important; border: none !important; box-shadow: none !important; backdrop-filter: none !important; padding: 0 !important; width: auto !important; max-width: none !important; }
.spectrum-card.minimal::before { display: none !important; }

.input-wrapper {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 45rpx;
  padding: 12rpx 16rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.55);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.14);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  transition: none;
}

.input-wrapper:focus-within {
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.14);
  border-color: rgba(0, 0, 0, 0.55);
  transform: none;
}

/* 万用键建议容器 */
.suggestions-area {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 4rpx;
  flex-shrink: 0;
}

/* 输入区域 */
.input-area {
  flex: 1;
  min-height: 64rpx;
  max-height: 200rpx;
  display: flex;
  align-items: center;
}

.voice-hold-btn {
  width: 100%;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  transition: none;
  position: relative;
  overflow: hidden;
  flex-direction: column;
  gap: 4rpx;
}

.voice-hold-btn.holding {
  transform: none;
  background: rgba(239, 68, 68, 0.06);
  border: 1.5rpx solid rgba(239, 68, 68, 0.18);
  border-radius: 20rpx;
}

.voice-ripple-container {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.voice-ripple {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(239, 68, 68, 0.5);
  animation: voiceRipple 1.4s ease-out infinite;
  opacity: 0;
}

.voice-ripple.r1 {
  width: 120%;
  height: 120%;
  top: -10%;
  left: -10%;
  animation-delay: 0s;
}

.voice-ripple.r2 {
  width: 120%;
  height: 120%;
  top: -10%;
  left: -10%;
  animation-delay: 0.45s;
}

.voice-ripple.r3 {
  width: 120%;
  height: 120%;
  top: -10%;
  left: -10%;
  animation-delay: 0.9s;
}

@keyframes voiceRipple {
  0% {
    transform: scale(0.5);
    opacity: 0.35;
  }
  100% {
    transform: scale(1.3);
    opacity: 0;
  }
}

.voice-hold-text {
  font-size: 28rpx;
  color: #111827;
  letter-spacing: 1rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
  transition: color 0.2s;
}

.voice-hold-btn.holding .voice-hold-text {
  color: #dc2626;
}

.voice-hold-hint {
  font-size: 20rpx;
  color: #ef4444;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.input-field {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.5;
  color: #1a1a1a;
  background-color: transparent;
  min-height: 64rpx;
  padding: 0;
}

.input-field::placeholder {
  color: #000000ff;
}

/* 输入操作 */
.input-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 响应式优化 */
@media (max-width: 375px) {
  .message-bubble {
    max-width: calc(100vw - 200rpx);
  }
}
