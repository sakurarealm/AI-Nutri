.nutrition-page {
  padding: 40rpx;
  max-width: 1000rpx;
  margin: 0 auto;
  background: linear-gradient(135deg, #f8fafc 0%, #e6f9f4 100%);
  min-height: 100vh;
  box-sizing: border-box;
  font-family: 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.family-handle {
  position: fixed;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1002;
  width: 92rpx;
  height: 132rpx;
  border-top-left-radius: 999rpx;
  border-bottom-left-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(232, 245, 242, 1);
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.family-handle::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
  background: linear-gradient(180deg, #00c896, #5e72e4);
}

.family-handle-text {
  font-size: 28rpx;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: 2rpx;
}

.family-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.22);
  backdrop-filter: blur(10rpx);
}

.family-drawer {
  position: fixed;
  top: 0;
  right: 0;
  height: 100vh;
  width: 280rpx;
  z-index: 1001;
  padding: 34rpx 18rpx 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(240, 249, 247, 0.96), rgba(255, 255, 255, 0.96));
  border-left: 2rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: -18rpx 0 60rpx rgba(0, 0, 0, 0.10);
  transform: translateX(110%);
  transition: transform 220ms ease;
}

.family-drawer.open {
  transform: translateX(0);
}

.family-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: 1rpx;
  margin-bottom: 18rpx;
}

.family-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.family-cell {
  position: relative;
  height: 96rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(232, 245, 242, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.03);
}

.family-del {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(239, 68, 68, 0.12);
  border: 2rpx solid rgba(239, 68, 68, 0.24);
  color: rgba(185, 28, 28, 1);
  font-size: 28rpx;
  font-weight: 900;
}

.family-cell.active {
  background: linear-gradient(135deg, rgba(0, 200, 150, 0.14), rgba(94, 114, 228, 0.10));
  border-color: rgba(0, 200, 150, 0.35);
}

.family-cell.me {
  background: linear-gradient(135deg, rgba(0, 200, 150, 0.22), rgba(0, 162, 255, 0.20));
  border-color: rgba(0, 200, 150, 0.45);
}

.family-cell.me.active {
  background: linear-gradient(135deg, rgba(0, 200, 150, 0.30), rgba(0, 162, 255, 0.26));
}

.family-cell.add {
  background: rgba(241, 245, 249, 1);
  border-color: rgba(226, 232, 240, 1);
  box-shadow: none;
}

.family-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
}

.family-cell.add .family-name {
  color: #94a3b8;
}

.family-sub {
  font-size: 22rpx;
  font-weight: 800;
  color: #94a3b8;
}

.family-footer {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 24rpx;
}

.sync-btn {
  height: 86rpx;
  border-radius: 26rpx;
  background: rgba(239, 68, 68, 0.10);
  border: 2rpx solid rgba(239, 68, 68, 0.22);
  color: rgba(185, 28, 28, 1);
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-food-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  background: rgba(15, 23, 42, 0.22);
  backdrop-filter: blur(18rpx);
}

.add-food-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 2001;
  width: 86vw;
  max-width: 680rpx;
  padding: 26rpx 26rpx 22rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 26rpx 80rpx rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(22rpx);
}

.add-food-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.add-food-modal-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
}

.add-food-modal-close {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 18rpx;
  background: rgba(241, 245, 249, 0.95);
  border: 2rpx solid rgba(226, 232, 240, 1);
  color: #334155;
  font-size: 34rpx;
  font-weight: 900;
}

.add-food-options {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 16rpx;
}

.add-food-option {
  flex: 1;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(232, 245, 242, 1);
  padding: 18rpx 14rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
}

.opt-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: rgba(0, 200, 150, 0.12);
  position: relative;
  border: 2rpx solid rgba(0, 200, 150, 0.22);
}

.opt-icon.camera::after,
.opt-icon.album::after,
.opt-icon.select::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 46rpx;
  height: 46rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(0, 200, 150, 0.85), rgba(94, 114, 228, 0.75));
}

.opt-icon.album {
  background: rgba(0, 162, 255, 0.10);
  border-color: rgba(0, 162, 255, 0.18);
}

.opt-icon.select {
  background: rgba(94, 114, 228, 0.10);
  border-color: rgba(94, 114, 228, 0.18);
}

.opt-text {
  font-size: 26rpx;
  font-weight: 900;
  color: #0f172a;
  text-align: center;
}

.delete-confirm-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
  text-align: center;
  padding: 22rpx 10rpx 28rpx;
}

.delete-confirm-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.delete-confirm-btn {
  flex: 1;
  height: 86rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(226, 232, 240, 1);
  background: rgba(255, 255, 255, 0.9);
  color: #0f172a;
}

.delete-confirm-btn.cancel {
  background: rgba(241, 245, 249, 0.95);
  border-color: rgba(226, 232, 240, 1);
  color: #334155;
}

.delete-confirm-btn.ok {
  background: rgba(239, 68, 68, 0.12);
  border-color: rgba(239, 68, 68, 0.24);
  color: rgba(185, 28, 28, 1);
}

/* 月份选择器 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(to right, #f0f9f7, #ffffff);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
}

.month-nav {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 52rpx;
  color: #2d3748;
  font-weight: 700;
}

.month-pill {
  position: relative;
  overflow: hidden;
  padding: 18rpx 44rpx;
  background: linear-gradient(135deg, #00c896, #00a2ff);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 26rpx rgba(0, 200, 150, 0.22);
}

.month-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.month-pill .shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
}

/* 日期滑动条 */
.date-strip {
  width: 100%;
  background-color: #ffffff;
  border-radius: 30rpx;
  padding: 28rpx 0 22rpx;
  margin: 0 0 70rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.date-strip .top-line-track,
.date-strip .top-line {
  position: absolute;
  top: 0;
  left: 22rpx;
  right: 22rpx;
  height: 8rpx;
  border-radius: 999rpx;
  pointer-events: none;
}

.date-strip .top-line-track {
  background: rgba(226, 232, 240, 0.9);
}

.date-strip .top-line {
  right: auto;
  width: 110rpx;
  background: linear-gradient(90deg, #00c896, #5e72e4);
  transition: width 220ms ease;
}

.date-list {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx 0;
  gap: 18rpx;
  position: relative;
}

.date-item {
  width: 110rpx;
  height: 124rpx;
  border-radius: 26rpx;
  background: #f8fafc;
  border: 2rpx solid #e8f5f2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.03);
  flex-shrink: 0;
}

.date-item.active {
  background: linear-gradient(135deg, rgba(0, 200, 150, 0.12), rgba(94, 114, 228, 0.10));
  border-color: rgba(0, 200, 150, 0.35);
}

.date-day {
  font-size: 40rpx;
  font-weight: 800;
  color: #2d3748;
}

.date-week {
  font-size: 24rpx;
  font-weight: 700;
  color: #00c896;
  opacity: 0.9;
}

/* 卡片通用 */
.nutrition-summary,
.meal-box {
  background: #ffffff;
  border: 2rpx solid #e0f0ec;
  border-radius: 40rpx;
  padding: 50rpx;
  margin-bottom: 70rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.05), 0 2rpx 6rpx rgba(0, 200, 150, 0.1);
  position: relative;
  overflow: hidden;
}

.nutrition-summary {
  padding: 44rpx 44rpx 40rpx;
}

.card-topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 12rpx;
  background: linear-gradient(90deg, #00c896, #5e72e4);
}

/* 标题 */
.summary-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  color: #2d3748;
  padding-bottom: 18rpx;
  position: relative;
}

.title-bar {
  width: 12rpx;
  height: 48rpx;
  margin-right: 24rpx;
  background: linear-gradient(to bottom, #00c896, #5e72e4);
  border-radius: 6rpx;
}

/* 圆环 */
.summary-body {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.circle-panel {
  flex: 0 0 auto;
}

.circle-box {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 60rpx;
}

.outer-circle {
  width: 220rpx;
  height: 220rpx;
  border: none;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 40rpx rgba(0, 0, 0, 0.08);
}

.circle-canvas {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.remain-text {
  font-size: 24rpx;
  color: #718096;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.main-value {
  font-size: 56rpx;
  font-weight: 800;
  color: #2d3748;
  margin-bottom: 6rpx;
  text-shadow: 0 6rpx 20rpx rgba(0, 200, 150, 0.3);
}

.main-label {
  font-size: 26rpx;
  color: #00c896;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.macro-panel {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border: 2rpx solid #e8f5f2;
  border-radius: 30rpx;
  padding: 18rpx 18rpx 10rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.03);
}

.macro-row {
  padding: 14rpx 8rpx 16rpx;
}

.macro-row + .macro-row {
  border-top: 2rpx solid rgba(226, 232, 240, 0.9);
}

.macro-row-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.macro-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #2d3748;
  white-space: nowrap;
}

.macro-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #00c896;
  white-space: nowrap;
}

@media (max-width: 420px) {
  .summary-body {
    flex-direction: column;
  }
  .macro-panel {
    width: 100%;
  }
  .outer-circle {
    width: 260rpx;
    height: 260rpx;
  }
}

/* 餐食记录 */
.meal-box {
  padding: 38rpx 38rpx 32rpx;
  margin-bottom: 50rpx;
}

.impact-box {
  padding: 38rpx 38rpx 34rpx;
}

.impact-header {
  margin-bottom: 18rpx;
}

.impact-title {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 900;
  color: #0f172a;
}

.impact-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
}

.impact-scroll {
  width: 100%;
}

.impact-row {
  display: flex;
  gap: 16rpx;
  padding: 6rpx 2rpx 2rpx;
}

.impact-card {
  width: 260rpx;
  flex-shrink: 0;
  border-radius: 30rpx;
  border: 2rpx solid rgba(232, 245, 242, 1);
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
  padding: 18rpx 18rpx 16rpx;
  overflow: hidden;
  position: relative;
}

.impact-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(to bottom, #00c896, #5e72e4);
  opacity: 0.75;
}

.impact-card.impact-neutral::before {
  background: linear-gradient(to bottom, rgba(148, 163, 184, 0.8), rgba(94, 114, 228, 0.35));
}

.impact-card.impact-bad::before {
  background: linear-gradient(to bottom, rgba(239, 68, 68, 0.75), rgba(245, 158, 11, 0.35));
}

.impact-card-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.impact-emoji {
  font-size: 36rpx;
}

.impact-name {
  font-size: 28rpx;
  font-weight: 900;
  color: #0f172a;
}

.impact-delta {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.impact-delta-good {
  color: #00c896;
}

.impact-delta-neutral {
  color: #334155;
}

.impact-delta-bad {
  color: #ef4444;
}

.impact-reason {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
  line-height: 1.45;
}

.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
  padding-bottom: 20rpx;
  border-bottom: 4rpx solid #e2e8f0;
}

.meal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #2d3748;
  display: flex;
  align-items: center;
}

.unit {
  font-size: 28rpx;
  color: #718096;
  font-weight: 500;
}

.food-record {
  display: flex;
  align-items: center;
  padding: 22rpx 22rpx;
  border-radius: 30rpx;
  margin: 14rpx 0;
  background: #ffffff;
  border: 2rpx solid #e8f5f2;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.03);
  position: relative;
  overflow: hidden;
}

.food-record .side-gradient {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(to bottom, #00c896, #5e72e4);
}

.food-record .side-gradient.gray {
  background: linear-gradient(to bottom, rgba(148, 163, 184, 0.75), rgba(148, 163, 184, 0.35));
}

.add-food-row {
  display: flex;
  align-items: center;
  padding: 16rpx 22rpx;
  border-radius: 30rpx;
  margin: 14rpx 0 0;
  background: rgba(248, 250, 252, 1);
  border: 2rpx dashed rgba(226, 232, 240, 1);
  position: relative;
  overflow: hidden;
}

.add-food-plus {
  width: 112rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(232, 245, 242, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  color: #00c896;
  margin-left: 0;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.03);
}

.add-food-text {
  margin-left: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #334155;
}

.food-arrow {
  font-size: 28rpx;
  color: #94a3b8;
  margin-left: 14rpx;
}

.food-image {
  width: 112rpx;
  height: 112rpx;
  background-color: #f0f7f5;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 3rpx solid #e8f5f2;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.food-info {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.food-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d3748;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-unit {
  font-size: 26rpx;
  color: #718096;
  font-weight: 500;
}

.food-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #4a5568;
  font-weight: 600;
}

.food-value .arrow {
  font-size: 40rpx;
  margin-left: 20rpx;
  color: #a0aec0;
}

/* 轻动效：用 hover-class 模拟按压/激活 */
.card-pressed {
  transform: translateY(-8rpx);
  box-shadow: 0 20rpx 40rpx rgba(0, 200, 150, 0.15) !important;
}

.btn-pressed {
  transform: translateY(-4rpx);
}

.row-pressed {
  background: #e6f9f4;
}

/* 入场动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.nutrition-summary,
.meal-box {
  animation: fadeIn 0.6s ease-out;
}

.add-snack-row {
  display: flex;
  align-items: center;
  padding: 18rpx 22rpx;
  border-radius: 30rpx;
  margin: 14rpx 0 50rpx;
  background: rgba(255, 255, 255, 1);
  border: 2rpx solid rgba(232, 245, 242, 1);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.add-snack-row .side-gradient {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
}

.add-snack-row .side-gradient.blue {
  background: linear-gradient(to bottom, #00a2ff, #5e72e4);
}

.add-snack-plus {
  width: 112rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(0, 162, 255, 0.16), rgba(94, 114, 228, 0.14));
  border: 2rpx solid rgba(0, 162, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  color: #2563eb;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.03);
}

