<proactive-notification id="proactive-notification" />
<view class="nutrition-page">
  <view class="month-bar" hover-class="card-pressed">
    <text class="month-nav" bindtap="prevMonth">‹</text>
    <picker mode="date" fields="month" value="{{monthPickerValue}}" bindchange="onMonthPickerChange">
      <view class="month-pill" hover-class="btn-pressed">
        <text class="month-text">{{currentMonthText}}</text>
      </view>
    </picker>
    <text class="month-nav" bindtap="nextMonth">›</text>
  </view>

  <scroll-view class="date-strip" scroll-x="true" enhanced show-scrollbar="{{false}}" scroll-left="{{dateScrollLeft}}" scroll-with-animation>
    <view class="date-list">
      <view class="top-line-track"></view>
      <view class="top-line" style="width: {{dateTopLineW}}rpx"></view>
      <view
        wx:for="{{monthDays}}"
        wx:key="id"
        id="day-{{item.day}}"
        class="date-item {{item.selected ? 'active' : ''}}"
        data-day="{{item.day}}"
        bindtap="onSelectDay"
        hover-class="btn-pressed"
      >
        <text class="date-day">{{item.day}}</text>
        <text class="date-week">{{item.week}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 圆环进度与营养统计 -->
  <view class="nutrition-summary" hover-class="card-pressed">
    <view class="card-topbar"></view>
    <text class="summary-title">
      <view class="title-bar"></view>
      今日营养
    </text>

    <view class="summary-body">
      <view class="circle-panel">
        <view class="outer-circle">
          <text class="remain-text">已摄入（千卡）</text>
          <text class="main-value">{{calorieConsumed}}</text>
          <text class="main-label">目标 {{calorieTarget}} 千卡</text>
        </view>
      </view>

      <view class="macro-panel" hover-class="card-pressed">
        <view class="macro-row" wx:for="{{macroItems}}" wx:key="key">
          <view class="macro-row-top">
            <text class="macro-name">{{item.name}}</text>
            <text class="macro-value">{{item.value}}</text>
          </view>
          <progress percent="{{item.percent}}" stroke-width="6" active active-color="#00c896" />
        </view>
      </view>
    </view>
  </view>

  <view class="meal-box impact-box" hover-class="card-pressed">
    <view class="card-topbar"></view>
    <view class="impact-header">
      <view class="impact-title">
        <view class="title-bar"></view>
        <text>饮食影响器官</text>
      </view>
      <text class="impact-subtitle">点一个器官，查看饮食如何改变指标与建议</text>
    </view>

    <scroll-view class="impact-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="impact-row">
        <view
          wx:for="{{organImpacts}}"
          wx:key="key"
          class="impact-card impact-{{item.level}}"
          data-key="{{item.key}}"
          bindtap="goOrganImpactDetail"
          hover-class="btn-pressed"
        >
          <view class="impact-card-top">
            <text class="impact-emoji">{{item.emoji}}</text>
            <text class="impact-name">{{item.name}}</text>
          </view>
          <text class="impact-delta impact-delta-{{item.level}}">{{item.deltaText}}</text>
          <text class="impact-reason">{{item.reason}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 餐食记录列表 -->
  <view class="meal-box" hover-class="card-pressed">
    <view class="card-topbar"></view>
    <view class="meal-header">
      <text class="meal-title">
        <uni-icons type="coffee" size="24" color="#00c896"></uni-icons>
        早餐
      </text>
      <text class="unit">单位（克）</text>
    </view>

    <view class="food-record" wx:for="{{breakfastFoods}}" wx:key="index" hover-class="row-pressed" data-meal="breakfastFoods" data-index="{{index}}" bindtap="onFoodTap">
      <view class="side-gradient"></view>
      <image class="food-image" src="{{item.img}}" mode="aspectFill" />
      <view class="food-info">
        <text class="food-name">{{item.name}}</text>
        <text class="food-unit">{{item.unit}}</text>
      </view>
      <view class="food-value">
        <text>{{item.nutrient}}</text>
        <text class="food-arrow">＞</text>
      </view>
    </view>

    <view class="add-food-row" data-meal="breakfastFoods" bindtap="openAddFoodModal" hover-class="row-pressed">
      <view class="side-gradient gray"></view>
      <view class="add-food-plus">＋</view>
      <text class="add-food-text">添加菜品</text>
    </view>
  </view>

  <view class="meal-box" hover-class="card-pressed">
    <view class="card-topbar"></view>
    <view class="meal-header">
      <text class="meal-title">
        <uni-icons type="sunny" size="24" color="#00c896"></uni-icons>
        中餐
      </text>
      <text class="unit">单位（克）</text>
    </view>

    <view class="food-record" wx:for="{{lunchFoods}}" wx:key="index" hover-class="row-pressed" data-meal="lunchFoods" data-index="{{index}}" bindtap="onFoodTap">
      <view class="side-gradient"></view>
      <image class="food-image" src="{{item.img}}" mode="aspectFill" />
      <view class="food-info">
        <text class="food-name">{{item.name}}</text>
        <text class="food-unit">{{item.unit}}</text>
      </view>
      <view class="food-value">
        <text>{{item.nutrient}}</text>
        <text class="food-arrow">＞</text>
      </view>
    </view>

    <view class="add-food-row" data-meal="lunchFoods" bindtap="openAddFoodModal" hover-class="row-pressed">
      <view class="side-gradient gray"></view>
      <view class="add-food-plus">＋</view>
      <text class="add-food-text">添加菜品</text>
    </view>
  </view>

  <view class="meal-box" hover-class="card-pressed">
    <view class="card-topbar"></view>
    <view class="meal-header">
      <text class="meal-title">
        <uni-icons type="moon" size="24" color="#00c896"></uni-icons>
        晚餐
      </text>
      <text class="unit">单位（克）</text>
    </view>

    <view class="food-record" wx:for="{{dinnerFoods}}" wx:key="index" hover-class="row-pressed" data-meal="dinnerFoods" data-index="{{index}}" bindtap="onFoodTap">
      <view class="side-gradient"></view>
      <image class="food-image" src="{{item.img}}" mode="aspectFill" />
      <view class="food-info">
        <text class="food-name">{{item.name}}</text>
        <text class="food-unit">{{item.unit}}</text>
      </view>
      <view class="food-value">
        <text>{{item.nutrient}}</text>
        <text class="food-arrow">＞</text>
      </view>
    </view>

    <view class="add-food-row" data-meal="dinnerFoods" bindtap="openAddFoodModal" hover-class="row-pressed">
      <view class="side-gradient gray"></view>
      <view class="add-food-plus">＋</view>
      <text class="add-food-text">添加菜品</text>
    </view>
  </view>

  <view wx:for="{{snackCards}}" wx:for-item="snack" wx:for-index="snackIndex" wx:key="id" class="meal-box snack-box snack-warn-{{snack.level}}" hover-class="card-pressed">
    <view class="card-topbar snack-topbar"></view>
    <view class="meal-header" bindtap="onSnackCardTap" data-index="{{snackIndex}}" hover-class="btn-pressed">
      <text class="meal-title">
        <uni-icons type="fire" size="24" color="#f59e0b"></uni-icons>
        加餐
      </text>
      <text class="unit">最多2个</text>
    </view>

    <view class="food-record" wx:for="{{snack.foods}}" wx:for-item="food" wx:for-index="foodIndex" wx:key="foodIndex" hover-class="row-pressed" data-meal="snack" data-snack-index="{{snackIndex}}" data-index="{{foodIndex}}" bindtap="onFoodTap">
      <view class="side-gradient"></view>
      <image class="food-image" src="{{food.img}}" mode="aspectFill" />
      <view class="food-info">
        <text class="food-name">{{food.name}}</text>
        <text class="food-unit">{{food.unit}}</text>
      </view>
      <view class="food-value">
        <text>{{food.nutrient}}</text>
        <text class="food-arrow">＞</text>
      </view>
    </view>

    <view wx:if="{{snack.foods.length < 2}}" class="add-food-row" data-meal="snack" data-snack-index="{{snackIndex}}" bindtap="openAddFoodModal" hover-class="row-pressed">
      <view class="side-gradient gray"></view>
      <view class="add-food-plus">＋</view>
      <text class="add-food-text">添加加餐食物</text>
    </view>
    <view wx:else class="snack-limit">已达上限</view>
  </view>

  <view class="add-snack-row" bindtap="addSnackCard" hover-class="btn-pressed">
    <view class="side-gradient blue"></view>
    <view class="add-snack-plus">＋</view>
    <text class="add-snack-text">添加加餐卡片</text>
  </view>
</view>

<view wx:if="{{!familyDrawerOpen}}" class="family-handle" bindtap="toggleFamilyDrawer" hover-class="btn-pressed">
  <text class="family-handle-text">家人</text>
</view>

<view wx:if="{{familyDrawerOpen}}" class="family-mask" bindtap="closeFamilyDrawer"></view>
<view class="family-drawer {{familyDrawerOpen ? 'open' : ''}}">
  <view class="family-title">我的家庭成员</view>
  <view class="family-grid">
    <view
      wx:for="{{familyMembers}}"
      wx:key="key"
      class="family-cell {{item.type === 'me' ? 'me' : ''}} {{item.type === 'add' ? 'add' : ''}} {{selectedMemberKey === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      data-id="{{item.id}}"
      bindtap="onFamilyCellTap"
      bindlongpress="onFamilyCellLongPress"
      hover-class="{{item.type === 'add' ? '' : 'card-pressed'}}"
    >
      <view wx:if="{{item.type === 'member'}}" class="family-del" catchtap="onMemberDeleteTap" data-key="{{item.key}}" data-id="{{item.id}}">×</view>
      <text class="family-name">{{item.name}}</text>
      <text wx:if="{{item.type === 'add'}}" class="family-sub">{{familyAddLocked ? 'VIP解锁' : '新增'}}</text>
    </view>
  </view>

  <view class="family-footer">
    <view class="sync-btn" bindtap="onSyncTodayTap" hover-class="btn-pressed">一键同步今日饮食</view>
  </view>
</view>

<view wx:if="{{addFoodModalOpen}}" class="add-food-mask" bindtap="closeAddFoodModal"></view>
<view wx:if="{{addFoodModalOpen}}" class="add-food-modal" catchtap="noop">
  <view class="add-food-modal-header">
    <text class="add-food-modal-title">您想如何添加？</text>
    <text class="add-food-modal-close" bindtap="closeAddFoodModal">×</text>
  </view>
  <view class="add-food-options">
    <view class="add-food-option" bindtap="onAddByCamera" hover-class="card-pressed">
      <view class="opt-icon camera"></view>
      <text class="opt-text">拍照添加</text>
    </view>
    <view class="add-food-option" bindtap="onAddByAlbum" hover-class="card-pressed">
      <view class="opt-icon album"></view>
      <text class="opt-text">从相册中添加</text>
    </view>
    <view class="add-food-option" bindtap="onAddBySelect" hover-class="card-pressed">
      <view class="opt-icon select"></view>
      <text class="opt-text">选择添加</text>
    </view>
  </view>
</view>

<view wx:if="{{deleteConfirmOpen}}" class="add-food-mask" bindtap="closeDeleteConfirm"></view>
<view wx:if="{{deleteConfirmOpen}}" class="add-food-modal" catchtap="noop">
  <view class="delete-confirm-title">要删除这条数据吗？</view>
  <view class="delete-confirm-actions">
    <view class="delete-confirm-btn cancel" bindtap="closeDeleteConfirm" hover-class="btn-pressed">否</view>
    <view class="delete-confirm-btn ok" bindtap="confirmDeleteFood" hover-class="btn-pressed">是</view>
  </view>
</view>
