<proactive-notification id="proactive-notification" />

<view class="page-container">
  <!-- 顶部导航 -->
  <view class="nav-header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <text class="page-title">营养册</text>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view 
    scroll-y="true" 
    bindscroll="onScroll"
    enable-back-to-top="{{false}}"
    scroll-anchoring="{{true}}"
    class="main-scroll"
  >
    <view class="container {{isScrolling ? 'scrolling-overlay' : ''}}">
      <!-- 营养摄入统计卡片 -->
      <view class="intake-card">
        <view class="intake-card-header">
          <view class="intake-title-section">
            <text class="intake-title">来看看您今天还需要摄入哪些食物吧~</text>
            <view class="add-food-btn" bindtap="navigateToFoodRecordPage">
              <text class="add-icon">+</text>
            </view>
          </view>
          <image class="doctor-illustration" src="/images/doctor-nutrition.png" mode="aspectFit" />
        </view>

        <!-- 营养进度条 -->
        <view class="nutrition-progress">
          <view class="progress-item">
            <view class="progress-label">
              <text class="label-name">碳水</text>
              <text class="label-value">{{dailyMacros.carb.current}}/{{dailyMacros.carb.target}}克</text>
            </view>
            <view class="progress-bar-bg">
              <view class="progress-bar-fill carb-fill" style="width:{{dailyMacros.carb.percent}}%"></view>
            </view>
          </view>

          <view class="progress-item">
            <view class="progress-label">
              <text class="label-name">脂肪</text>
              <text class="label-value">{{dailyMacros.fat.current}}/{{dailyMacros.fat.target}}克</text>
            </view>
            <view class="progress-bar-bg">
              <view class="progress-bar-fill fat-fill" style="width:{{dailyMacros.fat.percent}}%"></view>
            </view>
          </view>

          <view class="progress-item">
            <view class="progress-label">
              <text class="label-name">蛋白质</text>
              <text class="label-value">{{dailyMacros.protein.current}}/{{dailyMacros.protein.target}}克</text>
            </view>
            <view class="progress-bar-bg">
              <view class="progress-bar-fill protein-fill" style="width:{{dailyMacros.protein.percent}}%"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 分类标签栏 -->
      <view class="category-section">
        <scroll-view scroll-x="true" class="category-scroll" show-scrollbar="{{false}}">
          <view class="category-tabs">
            <view 
              wx:for="{{categories}}" 
              wx:key="key"
              class="category-tab {{selectedCategory === item.key ? 'active' : ''}}"
              bindtap="selectCategory"
              data-key="{{item.key}}"
            >
              <text>{{item.name}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="category-arrow" bindtap="showAllCategories">
          <text class="arrow-icon">›</text>
        </view>
      </view>

      <!-- 人体器官图示区域 -->
      <view class="body-diagram-section">
        <view class="body-diagram-container">
          <!-- 人体轮廓图 -->
          <image class="body-silhouette" src="/images/body-silhouette.png" mode="aspectFit" />

          <!-- 器官标签 -->
          <view class="organ-labels">
            <!-- 左侧器官 -->
            <view class="organ-label left" style="top: 8%; left: 5%;" bindtap="showOrganDetail" data-organ="brain">
              <image class="organ-icon" src="/images/organs/brain.png" mode="aspectFit" />
              <text class="organ-name">BRAIN</text>
              <text class="organ-category">基础代谢</text>
            </view>

            <view class="organ-label left" style="top: 25%; left: 2%;" bindtap="showOrganDetail" data-organ="lungs">
              <image class="organ-icon" src="/images/organs/lungs.png" mode="aspectFit" />
              <text class="organ-name">LUNGS</text>
            </view>

            <view class="organ-label left" style="top: 42%; left: 5%;" bindtap="showOrganDetail" data-organ="liver">
              <image class="organ-icon" src="/images/organs/liver.png" mode="aspectFit" />
              <text class="organ-name">LIVER</text>
            </view>

            <view class="organ-label left" style="top: 58%; left: 2%;" bindtap="showOrganDetail" data-organ="kidneys">
              <image class="organ-icon" src="/images/organs/kidneys.png" mode="aspectFit" />
              <text class="organ-name">KIDNEYS</text>
              <text class="organ-category">疾病预防</text>
            </view>

            <view class="organ-label left" style="top: 72%; left: 8%;" bindtap="showOrganDetail" data-organ="stomach">
              <image class="organ-icon" src="/images/organs/stomach.png" mode="aspectFit" />
              <text class="organ-name">STOMACH</text>
              <text class="organ-category">组织修复</text>
            </view>

            <!-- 右侧器官 -->
            <view class="organ-label right" style="top: 12%; right: 5%;" bindtap="showOrganDetail" data-organ="eyes">
              <image class="organ-icon" src="/images/organs/eyes.png" mode="aspectFit" />
              <text class="organ-name">EYES</text>
              <text class="organ-category">美容抗衰</text>
            </view>

            <view class="organ-label right" style="top: 28%; right: 2%;" bindtap="showOrganDetail" data-organ="heart">
              <image class="organ-icon" src="/images/organs/heart.png" mode="aspectFit" />
              <text class="organ-name">HEART</text>
              <text class="organ-category">心理健康</text>
            </view>

            <view class="organ-label right" style="top: 45%; right: 5%;" bindtap="showOrganDetail" data-organ="spleen">
              <image class="organ-icon" src="/images/organs/spleen.png" mode="aspectFit" />
              <text class="organ-name">SPLEEN</text>
            </view>

            <view class="organ-label right" style="top: 62%; right: 2%;" bindtap="showOrganDetail" data-organ="intestine">
              <image class="organ-icon" src="/images/organs/intestine.png" mode="aspectFit" />
              <text class="organ-name">INTESTINE</text>
              <text class="organ-category">疾病预防</text>
            </view>
          </view>

          <!-- 连接线 -->
          <view class="connection-lines">
            <view class="line line-brain" style="top: 12%; left: 25%; width: 20%;"></view>
            <view class="line line-lungs" style="top: 28%; left: 22%; width: 23%;"></view>
            <view class="line line-liver" style="top: 45%; left: 25%; width: 20%;"></view>
            <view class="line line-kidneys" style="top: 62%; left: 22%; width: 23%;"></view>
            <view class="line line-stomach" style="top: 76%; left: 28%; width: 18%;"></view>
            <view class="line line-eyes" style="top: 16%; right: 25%; width: 18%;"></view>
            <view class="line line-heart" style="top: 32%; right: 22%; width: 21%;"></view>
            <view class="line line-spleen" style="top: 49%; right: 25%; width: 18%;"></view>
            <view class="line line-intestine" style="top: 66%; right: 22%; width: 21%;"></view>
          </view>
        </view>

        <!-- 全部按钮 -->
        <view class="all-categories-btn" bindtap="showAllCategories">
          <text>全部</text>
        </view>
      </view>

      <!-- ========== 原有功能模块 ========== -->

      <!-- 搜索框 -->
      <view class="search-container">
        <view class="search-box">
          <icon type="search" size="20" color="#718096" />
          <input class="search-input" value="{{searchQuery}}" placeholder="搜索模块、如菜品..." bindinput="updateSearchQuery" confirm-type="search" bindconfirm="searchFood" />
        </view>
      </view>

      <!-- 营养记录卡片 -->
      <view class="card nutrition-card {{highlightedCard === 'nutrition-card' ? 'bloom-highlight' : ''}}" id="nutrition-card">
        <view class="card-topbar"></view>
        <view class="card-header">
          <view class="card-title">
            <text class="title-text">今日营养摄入</text>
          </view>
          <view class="action-btn" bindtap="navigateToDataPage">
            <text>查看详情</text>
            <icon type="arrowright" size="16" color="#00c896" />
          </view>
        </view>

        <view class="card-subtitle">已摄入 {{calorieConsumed}} / 目标 {{calorieTarget}} 千卡</view>

        <view class="nutrition-stats">
          <view class="stat-item carbs">
            <view class="stat-header">
              <view class="stat-name">
                <view class="stat-icon"></view>
                <text>碳水</text>
              </view>
              <text class="stat-value">{{dailyMacros.carb.current}}/{{dailyMacros.carb.target}}克</text>
            </view>
            <view class="progress-container">
              <view class="progress-bar carbs-bar" style="width:{{dailyMacros.carb.percent}}%"></view>
            </view>
          </view>

          <view class="stat-item fat">
            <view class="stat-header">
              <view class="stat-name">
                <view class="stat-icon fat-bg"></view>
                <text>脂肪</text>
              </view>
              <text class="stat-value">{{dailyMacros.fat.current}}/{{dailyMacros.fat.target}}克</text>
            </view>
            <view class="progress-container">
              <view class="progress-bar fat-bar" style="width:{{dailyMacros.fat.percent}}%"></view>
            </view>
          </view>

          <view class="stat-item protein">
            <view class="stat-header">
              <view class="stat-name">
                <view class="stat-icon protein-bg"></view>
                <text>蛋白</text>
              </view>
              <text class="stat-value">{{dailyMacros.protein.current}}/{{dailyMacros.protein.target}}克</text>
            </view>
            <view class="progress-container">
              <view class="progress-bar protein-bar" style="width:{{dailyMacros.protein.percent}}%"></view>
            </view>
          </view>
        </view>

        <view class="add-btn-container">
          <button class="new-add-button" bindtap="navigateToFoodRecordPage">
            <icon type="plus" size="18" color="#fff" />
            <text class="btn-text">添加食物记录</text>
          </button>
        </view>
      </view>

      <!-- 人体影响图卡片 -->
      <view class="card body-card {{highlightedCard === 'body-card' ? 'bloom-highlight' : ''}}" id="body-card">
        <view class="card-topbar"></view>
        <view class="card-header">
          <view class="card-title">
            <text class="title-text">人体影响图（基于今日摄入）</text>
          </view>
          <view class="action-btn" bindtap="navigateToDetail">
            <text>查看详情</text>
            <icon type="arrowright" size="16" color="#00c896" />
          </view>
        </view>

        <!-- 图例 -->
        <view class="body-legend">
          <view class="dot good"></view><text>良好</text>
          <view class="dot neutral"></view><text>中性</text>
          <view class="dot bad"></view><text>待优化</text>
        </view>

        <!-- 人体底图 + 热点 -->
        <view class="body-stage">
          <image class="body-image" src="/images/human.jpg" mode="aspectFit" />
          <view wx:for="{{regions}}" wx:key="key" class="hotspot" style="top: {{item.top}}; left: {{item.left}}; background: {{getRegionColor(regionScores[item.key] || 0)}}" bindtap="showRegionDetail" data-region="{{item}}">
            <text class="hotspot-label">{{item.name}}</text>
          </view>
        </view>

        <!-- 简短建议 -->
        <view class="body-suggestions">
          <view wx:for="{{bodySuggestions}}" wx:key="key" class="suggestion-item">
            <text class="sugg-title">{{item.title}}</text>
            <text class="sugg-text">{{item.text}}</text>
          </view>
        </view>
      </view>

      <!-- 菜品识别卡片 -->
      <view class="card recognition-card {{highlightedCard === 'recognition-card' ? 'bloom-highlight' : ''}}" id="recognition-card">
        <view class="card-topbar"></view>
        <view class="card-header">
          <view class="card-title">
            <text class="title-text">智能菜品识别</text>
          </view>
          <view class="action-btn" bindtap="navigateToRecognitionPage">
            <text>开始识别</text>
            <icon type="arrowright" size="16" color="#00c896" />
          </view>
        </view>

        <view class="card-subtitle">拍照或上传菜品图片，AI 一键识别营养成分，轻松记录摄入</view>

        <view class="recognition-intro">
          <view class="intro-step">
            <icon type="camera" size="24" color="#00c896" />
            <text class="step-text">1. 拍照菜品</text>
          </view>
          <view class="intro-step">
            <icon type="image" size="24" color="#00a2ff" />
            <text class="step-text">2. AI 自动解析</text>
          </view>
          <view class="intro-step">
            <icon type="add" size="24" color="#ff9a9e" />
            <text class="step-text">3. 一键添加记录</text>
          </view>
        </view>

        <view class="recognition-example">
          <image class="example-image" src="cloud://prod-8gp55z7w28be1fad.7072-prod-8gp55z7w28be1fad-1395409956/nutritionbrochure/ChatGPT Image 2026年1月14日 14_58_57 (1).png" mode="aspectFill" />
          <view class="example-overlay">
            <text class="example-title">示例：宫保鸡丁</text>
            <text class="example-desc">识别出蛋白25g、碳水18g、脂肪12g</text>
          </view>
        </view>
      </view>

      <!-- 养生食谱卡片 -->
      <view class="card recipe-card {{highlightedCard === 'recipe-card' ? 'bloom-highlight' : ''}}" id="recipe-card">
        <view class="card-topbar"></view>
        <view class="card-header">
          <view class="card-title">
            <text class="title-text">养生食谱推荐</text>
          </view>
          <view class="action-btn" bindtap="navigateToRecipePage">
            <text>全部食谱</text>
            <icon type="arrowright" size="16" color="#00c896" />
          </view>
        </view>

        <view class="card-subtitle">营养师为您定制的专属养生食谱，均衡营养更健康</view>

        <view class="recipe-grid">
          <view class="recipe-item">
            <image class="recipe-image" src="https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=600&h=600&q=80" mode="aspectFill" />
            <view class="recipe-overlay">
              <text class="recipe-title">鲜虾藜麦沙拉</text>
              <text class="recipe-calories">320卡路里</text>
            </view>
          </view>

          <view class="recipe-item">
            <image class="recipe-image" src="https://images.unsplash.com/photo-1490818387583-1baba5e638af?auto=format&fit=crop&w=600&h=600&q=80" mode="aspectFill" />
            <view class="recipe-overlay">
              <text class="recipe-title">三文鱼牛油果碗</text>
              <text class="recipe-calories">450卡路里</text>
            </view>
          </view>

          <view class="recipe-item">
            <image class="recipe-image" src="https://images.unsplash.com/photo-1505253758473-96b7015fcd40?auto=format&fit=crop&w=600&h=600&q=80" mode="aspectFill" />
            <view class="recipe-overlay">
              <text class="recipe-title">蔬菜豆腐汤</text>
              <text class="recipe-calories">280卡路里</text>
            </view>
          </view>

          <view class="recipe-item">
            <image class="recipe-image" src="https://images.unsplash.com/photo-1606755962773-d324e0a13086?auto=format&fit=crop&w=600&h=600&q=80" mode="aspectFill" />
            <view class="recipe-overlay">
              <text class="recipe-title">鸡肉糙米饭</text>
              <text class="recipe-calories">380卡路里</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 健康小贴士 -->
      <view class="card tips-card {{highlightedCard === 'tips-card' ? 'bloom-highlight' : ''}}" id="tips-card">
        <view class="card-topbar"></view>
        <view class="card-header">
          <view class="card-title">
            <text class="title-text">健康小贴士</text>
          </view>
        </view>

        <view class="card-subtitle">每天坚持这些小习惯，让您更健康</view>

        <view class="tips-container">
          <view class="tip-item" wx:for="{{tips}}" wx:key="index">
            <view class="bullet"></view>
            <text>{{item}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 分类详情弹窗 -->
  <view class="category-detail-modal {{showCategoryModal ? 'show' : ''}}" bindtap="hideCategoryModal">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-header">
        <text class="modal-title">营养册</text>
        <view class="close-btn" bindtap="hideCategoryModal">
          <text class="close-icon">×</text>
        </view>
      </view>
      
      <scroll-view scroll-y="true" class="category-detail-scroll">
        <view class="category-detail-list">
          <view wx:for="{{categoryDetails}}" wx:key="key" class="category-detail-item">
            <view class="detail-section-title">{{item.name}}</view>
            <view class="detail-tags">
              <view wx:for="{{item.subItems}}" wx:for-item="subItem" wx:key="index" class="detail-tag">
                <text>{{subItem}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

<custom-tabbar id="tabbar" />
