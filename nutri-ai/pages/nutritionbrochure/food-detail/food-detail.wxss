.page { min-height: 100vh; background: #fdfdff; position: relative; overflow: hidden; }

.bg { position: fixed; inset: 0; pointer-events: none; }
.bg-orb { position: absolute; border-radius: 9999rpx; filter: blur(100rpx); opacity: 0.2; animation: breathe 22s ease-in-out infinite; }
.orb1 { width: 720rpx; height: 720rpx; left: -300rpx; top: -200rpx; background: radial-gradient(circle, rgba(20,184,166,0.18), transparent 70%); }
.orb2 { width: 800rpx; height: 800rpx; right: -320rpx; bottom: -240rpx; background: radial-gradient(circle, rgba(14,165,233,0.16), transparent 70%); }
@keyframes breathe { 0%, 100% { transform: scale(1) translate(0, 0); } 50% { transform: scale(1.08) translate(20rpx, -20rpx); } }

.nav { position: fixed; top: 0; left: 0; right: 0; padding-left: 48rpx; padding-right: 48rpx; backdrop-filter: blur(20rpx); background: rgba(253,253,255,0.9); z-index: 10; display: flex; justify-content: space-between; align-items: center; }
.back-icon { font-size: 56rpx; color: #0f172a; }
.nav-title { font-size: 40rpx; font-weight: 900; color: #0f172a; }
.heart-icon { font-size: 48rpx; color: #0f172a; transition: all 300ms ease; }
.nav-right.favorited .heart-icon { color: #ef4444; transform: scale(1.2); }

.content { padding-left: 48rpx; padding-right: 48rpx; } /* 底部间距加大 */

.reason-section { margin-bottom: 120rpx; text-align: center; opacity: 0; animation: fadeUp 800ms ease forwards; animation-delay: 200ms; }
.reason-text { font-size: 34rpx; line-height: 1.7; color: #475569; max-width: 90%; margin: 0 auto; }

.hero-card { height: 560rpx; border-radius: 48rpx; overflow: hidden; box-shadow: 0 20rpx 60rpx rgba(15,23,42,0.08); margin-bottom: 140rpx; position: relative; opacity: 0; animation: fadeUp 800ms ease forwards; animation-delay: 400ms; }
.hero-image { width: 100%; height: 100%; object-fit: cover; }
.overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 48rpx; background: linear-gradient(transparent, rgba(0,0,0,0.6)); }
.overlay .title { font-size: 48rpx; font-weight: 900; color: #ffffff; margin-bottom: 24rpx; }
.meta { display: flex; justify-content: space-between; }
.calories, .time { font-size: 48rpx; font-weight: 900; color: #ffffff; text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.4); }

@keyframes fadeUp { from { opacity: 0; transform: translateY(40rpx); } to { opacity: 1; transform: none; } }

/* 所有 section 间距加大，动画 delay 顺滑 */
.nutrition-section, .ingredients-section, .steps-section, .value-section { margin-top: 160rpx; opacity: 0; animation: fadeUp 800ms ease forwards; }
.nutrition-section { animation-delay: 600ms; }
.ingredients-section { animation-delay: 800ms; }
.steps-section { animation-delay: 1000ms; }
.value-section { animation-delay: 1200ms; }

.section-title { font-size: 42rpx; font-weight: 900; color: #0f172a; }
.section-sub { margin: 20rpx 0 80rpx; font-size: 28rpx; color: #64748b; } /* sub 间距加大 */

/* 营养圈保持，但整体间距大 */
.nutrition-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 80rpx; text-align: center; }
.nutrition-grid .circle { width: 200rpx; height: 200rpx; border-radius: 50%; margin: 0 auto 32rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 10rpx 40rpx rgba(15,23,42,0.06); }
.circle.carb { background: linear-gradient(135deg, #ffd4a3, #ff9a4a); }
.circle.protein { background: linear-gradient(135deg, #a3e4d7, #34d399); }
.circle.fat { background: linear-gradient(135deg, #c3aed6, #9b59b6); }
.circle.fiber { background: linear-gradient(135deg, #d5d8dc, #95a5a6); }
.circle .value { font-size: 48rpx; font-weight: 900; color: #0f172a; }
.nutrition-grid .label { font-size: 30rpx; color: #475569; }

/* 食材和步骤卡片：去除强白块感，改淡边框 + 大 padding + 大间距 */
.ingredients-section .list, .steps-section .list { background: transparent; border-radius: 48rpx; padding: 0; box-shadow: none; border: 2rpx solid #eef2f6; }
.ingredients-section .item { display: flex; justify-content: space-between; padding: 36rpx 0; border-bottom: 1rpx solid #eef2f6; font-size: 32rpx; color: #475569; }
.ingredients-section .item:last-child { border-bottom: none; }
.ingredients-section .name { font-weight: 600; color: #0f172a; }

.steps-section .step { display: flex; gap: 40rpx; padding: 56rpx 0; border-bottom: 1rpx solid #eef2f6; }
.steps-section .step:last-child { border-bottom: none; }
.step .number { width: 88rpx; height: 88rpx; border-radius: 50%; background: linear-gradient(135deg, #667eea, #764ba2); color: #ffffff; font-size: 44rpx; font-weight: 900; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.step .step-content .title { font-size: 38rpx; font-weight: 900; color: #0f172a; margin-bottom: 20rpx; display: block; }
.step .step-content .desc { font-size: 32rpx; line-height: 1.7; color: #475569; margin-bottom: 20rpx; }
.step .time { font-size: 28rpx; color: #64748b; background: #f1f5f9; padding: 10rpx 24rpx; border-radius: 24rpx; align-self: flex-start; }

/* 为什么适合你：彻底解决白块问题，纯文字 + 淡绿强调 + 大留白 */
.value-section .value-text { 
  font-size: 34rpx; 
  line-height: 1.9; 
  color: #334155; 
  background: transparent; 
  padding: 0; 
  border-radius: 0; 
  box-shadow: none; 
  text-align: center; 
  max-width: 90%; 
  margin: 60rpx auto 0; 
  border-left: 6rpx solid #10b981; 
  padding-left: 40rpx; 
  background: linear-gradient(90deg, rgba(16,185,129,0.04) 0%, transparent 100%);
}

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding-top: 40rpx; padding-left: 48rpx; padding-right: 48rpx; background: rgba(253,253,255,0.95); backdrop-filter: blur(20rpx); display: flex; gap: 32rpx; }
.btn { flex: 1; height: 100rpx; border-radius: 50rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; transition: transform 200ms ease; }
.btn.secondary { background: #f1f5f9; color: #0f172a; border: 2rpx solid #e2e8f0; }
.btn.primary { background: linear-gradient(135deg, #10b981, #34d399); color: #ffffff; box-shadow: 0 10rpx 30rpx rgba(16,185,129,0.3); }
.btn:active { transform: scale(0.96); }
