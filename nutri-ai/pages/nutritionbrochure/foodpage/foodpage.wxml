<proactive-notification id="proactive-notification" />

<view class="page">
  <view class="bg">
    <view class="bg-orb orb1"></view>
    <view class="bg-orb orb2"></view>
  </view>

  <!-- 自定义导航 -->
  <view class="nav" style="padding-top: {{navPaddingTopPx}}px;">
    <view class="nav-left" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <text class="nav-title">今日饮食建议</text>
    <view class="nav-right"></view>
  </view>

  <view class="content">
    <!-- AI 总结 -->
    <view class="summary-section">
      <text class="summary-title">为什么推荐这些</text>
      <text class="summary-text">{{todaySummary}}</text>
    </view>

    <!-- 推荐菜谱 -->
    <view class="recipe-list">
      <view class="recipe-card" 
            wx:for="{{recipeList}}" 
            wx:key="title"
            bindtap="goToRecipeDetail"
            data-recipe="{{item}}"
            animation="{{item.animation}}">
        <view class="image-container">
          <image class="recipe-image" src="{{item.image}}" mode="aspectFill" />
          <view class="overlay">
            <text class="calories">{{item.calories}} 卡</text>
            <text class="time">{{item.time}}</text>
          </view>
        </view>

        <view class="content">
          <text class="title">{{item.title}}</text>
          <text class="reason">{{item.reason}}</text>
        </view>
      </view>
    </view>

    <view class="food-section">
      <view class="section-head">
        <text class="section-title">菜品库</text>
        <text class="section-sub">点开查看营养与做法建议</text>
      </view>

      <view class="search-row">
        <text class="search-icon">🔎</text>
        <input class="search-input" value="{{foodKeyword}}" placeholder="搜索菜品名称" bindinput="onFoodKeywordInput" />
        <view wx:if="{{foodKeyword}}" class="search-clear" bindtap="clearFoodKeyword">×</view>
      </view>

      <view class="food-list">
        <view class="food-card"
              wx:for="{{foodKeyword ? foodSearchList : foodList}}"
              wx:key="id"
              bindtap="goToFoodDetail"
              data-food="{{item}}">
          <image wx:if="{{item.img}}" class="food-img" src="{{item.img}}" mode="aspectFill" />
          <view wx:else class="food-img placeholder"></view>
          <view class="food-main">
            <text class="food-name">{{item.name}}</text>
            <text class="food-sub">{{item.nutrient}} · {{item.calorie}}kcal · {{item.unit}}</text>
          </view>
          <text class="food-arrow">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
