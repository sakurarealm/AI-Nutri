.page { min-height: 100vh; background: #fdfdff; position: relative; overflow: hidden; }

.bg { position: fixed; inset: 0; pointer-events: none; }
.bg-orb { position: absolute; border-radius: 9999rpx; filter: blur(100rpx); opacity: 0.2; animation: breathe 22s ease-in-out infinite; }
.orb1 { width: 720rpx; height: 720rpx; left: -300rpx; top: -200rpx; background: radial-gradient(circle, rgba(20,184,166,0.18), transparent 70%); }
.orb2 { width: 800rpx; height: 800rpx; right: -320rpx; bottom: -240rpx; background: radial-gradient(circle, rgba(14,165,233,0.16), transparent 70%); }
@keyframes breathe {
  0%, 100% { transform: scale(1) translate(0, 0); }
  50% { transform: scale(1.08) translate(20rpx, -20rpx); }
}

.nav { position: fixed; top: 0; left: 0; right: 0; padding: calc(env(safe-area-inset-top) + 24rpx) 48rpx 24rpx; backdrop-filter: blur(20rpx); background: rgba(253,253,255,0.9); z-index: 10; display: flex; justify-content: space-between; align-items: center; }
.back-icon { font-size: 56rpx; color: #0f172a; }
.nav-title { font-size: 40rpx; font-weight: 900; color: #0f172a; }

.page > .content { padding: calc(env(safe-area-inset-top) + 220rpx) 48rpx 100rpx; }

.summary-section { margin-bottom: 120rpx; text-align: center; }
.summary-title { font-size: 30rpx; font-weight: 800; color: #0f172a; letter-spacing: 2rpx; margin-bottom: 18rpx; display: block; }
.summary-text { font-size: 34rpx; line-height: 1.65; color: #475569; max-width: 90%; margin: 0 auto; }

.recipe-list { display: flex; flex-direction: column; gap: 80rpx; }

.recipe-card { background: #ffffff; border-radius: 48rpx; overflow: hidden; box-shadow: 0 20rpx 60rpx rgba(15,23,42,0.06); opacity: 0; animation: fadeUp 800ms ease forwards; transition: transform 200ms ease, box-shadow 200ms ease; }
.recipe-card:nth-child(1) { animation-delay: 200ms; }
.recipe-card:nth-child(2) { animation-delay: 400ms; }
.recipe-card:nth-child(3) { animation-delay: 600ms; }
.recipe-card:nth-child(4) { animation-delay: 800ms; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(40rpx); } to { opacity: 1; transform: none; } }
.recipe-card:active { transform: scale(0.98); box-shadow: 0 30rpx 80rpx rgba(15,23,42,0.12); }

.image-container { position: relative; height: 480rpx; }
.recipe-image { width: 100%; height: 100%; object-fit: cover; }
.overlay { position: absolute; bottom: 32rpx; left: 32rpx; right: 32rpx; display: flex; justify-content: space-between; }
.calories, .time { font-size: 48rpx; font-weight: 900; color: #ffffff; text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.4); }

.recipe-card .content { padding: 48rpx; }
.title { font-size: 44rpx; font-weight: 900; color: #0f172a; line-height: 1.3; display: block; margin-bottom: 32rpx; }
.reason { font-size: 32rpx; line-height: 1.65; color: #475569; }

.food-section { margin-top: 140rpx; }
.section-head { margin-bottom: 36rpx; }
.section-title { font-size: 42rpx; font-weight: 900; color: #0f172a; display: block; }
.section-sub { margin-top: 14rpx; font-size: 28rpx; color: #64748b; display: block; }

.search-row { display: flex; align-items: center; padding: 18rpx 22rpx; border-radius: 30rpx; background: rgba(248, 250, 252, 1); border: 2rpx solid rgba(226, 232, 240, 1); margin-bottom: 28rpx; }
.search-icon { font-size: 30rpx; margin-right: 14rpx; }
.search-input { flex: 1; font-size: 30rpx; font-weight: 700; color: #0f172a; }
.search-clear { width: 64rpx; height: 64rpx; border-radius: 22rpx; background: rgba(255, 255, 255, 0.92); border: 2rpx solid rgba(232, 245, 242, 1); display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 900; color: #94a3b8; box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.03); }

.food-list { display: flex; flex-direction: column; gap: 22rpx; }
.food-card { display: flex; align-items: center; gap: 22rpx; padding: 22rpx 22rpx; border-radius: 36rpx; background: #ffffff; border: 2rpx solid #eef2f6; box-shadow: 0 10rpx 30rpx rgba(15,23,42,0.04); }
.food-card:active { transform: scale(0.99); }
.food-img { width: 112rpx; height: 112rpx; border-radius: 28rpx; overflow: hidden; background: #f1f5f9; flex-shrink: 0; }
.food-img.placeholder { background: rgba(241, 245, 249, 1); }
.food-main { flex: 1; min-width: 0; }
.food-name { font-size: 34rpx; font-weight: 900; color: #0f172a; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.food-sub { margin-top: 10rpx; font-size: 26rpx; color: #475569; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.food-arrow { font-size: 46rpx; color: #94a3b8; padding-left: 6rpx; }
