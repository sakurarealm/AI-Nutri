/* ==================== 基础变量 ==================== */
page {
  --green: #48bb78;
  --green-600: #38a169;
  --green-50: #f0fdf4;
  --orange: #ed8936;
  --red: #f56565;
  --slate-900: #0f172a;
  --slate-800: #1e293b;
  --slate-700: #334155;
  --slate-600: #475569;
  --slate-500: #64748b;
  --slate-400: #94a3b8;
  --white: #ffffff;
}

/* ==================== 基础布局 ==================== */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--green-50) 0%, #ffffff 50%, var(--green-50) 100%);
  position: relative;
  overflow: hidden;
}

.particle-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}

/* ==================== 导航栏 ==================== */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(72, 187, 120, 0.1);
}

.navbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(72, 187, 120, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
.nav-btn:active {
  transform: scale(0.92);
  background: rgba(72, 187, 120, 0.16);
}

.nav-title {
  flex: 1;
  text-align: center;
  padding: 0 32rpx;
}

.organ-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a202c;
  line-height: 1.2;
}

.organ-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--green);
  margin-top: 4rpx;
}

/* ==================== 滚动容器 ==================== */
.main-scroll {
  height: 100vh;
  position: relative;
  z-index: 1;
}

/* ==================== 器官选择 ==================== */
.organ-selector {
  padding: 24rpx 0 8rpx;
}
.organ-tabs {
  width: 100%;
  white-space: nowrap;
}
.organ-tabs-row {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx;
}
.organ-tab {
  flex-shrink: 0;
  min-width: 190rpx;
  height: 108rpx;
  border-radius: 28rpx;
  padding: 16rpx 18rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(72, 187, 120, 0.10);
  box-shadow: 0 12rpx 28rpx rgba(72, 187, 120, 0.10);
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.organ-tab:active { transform: scale(0.99); }
.organ-tab.active {
  border-color: rgba(72, 187, 120, 0.32);
  background: linear-gradient(135deg, rgba(240, 253, 244, 0.95) 0%, rgba(255, 255, 255, 0.92) 100%);
  box-shadow: 0 18rpx 42rpx rgba(72, 187, 120, 0.14);
}
.organ-tab-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(72, 187, 120, 0.10);
}
.organ-tab-icon.score-good { background: rgba(72, 187, 120, 0.12); }
.organ-tab-icon.score-neutral { background: rgba(237, 137, 54, 0.14); }
.organ-tab-icon.score-bad { background: rgba(245, 101, 101, 0.14); }
.organ-tab-emoji { font-size: 34rpx; }
.organ-tab-text { display: flex; flex-direction: column; }
.organ-tab-name { font-size: 26rpx; font-weight: 800; color: var(--slate-900); line-height: 1.2; }
.organ-tab-score { font-size: 22rpx; color: var(--slate-500); margin-top: 6rpx; }

/* ==================== 通用卡片基样式 ==================== */
.hero-card,
.info-card,
.trend-card,
.tip-card,
.metrics-card,
.suggestions-card,
.foods-card,
.ai-card,
.achievements-card,
.footer-actions {
  margin: 32rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(72, 187, 120, 0.12);
  position: relative;
}

/* ==================== 进入动画 ==================== */
.slide-up {
  opacity: 0;
  transform: translateY(40rpx);
  animation: slideUp 0.55s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}
@keyframes slideUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==================== 英雄卡片 ==================== */
.hero-card {
  border-radius: 48rpx;
  background: linear-gradient(135deg, #ffffff 0%, var(--green-50) 100%);
  overflow: hidden;
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}
.hero-card.card-animate {
  opacity: 1;
  transform: translateY(0);
}

.hero-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  opacity: 0.6;
}

.circle-decoration {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(72, 187, 120, 0.15) 0%, transparent 70%);
  animation: float 6s ease-in-out infinite;
}
.circle-1 { width: 300rpx; height: 300rpx; top: -100rpx; right: -100rpx; animation-delay: 0s; }
.circle-2 { width: 200rpx; height: 200rpx; bottom: -50rpx; left: -50rpx; animation-delay: 2s; }
.circle-3 { width: 150rpx; height: 150rpx; top: 50%; right: 10%; animation-delay: 4s; }
@keyframes float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(20rpx, 20rpx) scale(1.08); }
}

.hero-content { position: relative; z-index: 1; padding: 48rpx; }

/* ==================== 评分区域 ==================== */
.score-section {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 48rpx;
}

.score-ring { position: relative; flex-shrink: 0; }
.ring-svg { width: 200rpx; height: 200rpx; }
.score-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}
.score-number {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
  background: linear-gradient(135deg, var(--green) 0%, var(--green-600) 100%);
  -webkit-background-clip: text;
  color: transparent;
  background-clip: text;
}
.score-label { display: block; font-size: 22rpx; color: var(--slate-400); margin-top: 8rpx; font-weight: 600; }

.score-info { flex: 1; }
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 28rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.status-badge.score-good { background: rgba(72, 187, 120, 0.1); color: var(--green); }
.status-badge.score-neutral { background: rgba(237, 137, 54, 0.1); color: var(--orange); }
.status-badge.score-bad { background: rgba(245, 101, 101, 0.1); color: var(--red); }
.badge-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: currentColor; animation: pulseDot 2s ease-in-out infinite; }
@keyframes pulseDot { 0%,100% {opacity:1; transform:scale(1);} 50% {opacity:.6; transform:scale(1.2);} }
.score-summary { display: block; font-size: 26rpx; color: var(--slate-500); line-height: 1.6; }
.diet-impact { display: block; margin-top: 10rpx; font-size: 24rpx; color: var(--slate-600); line-height: 1.55; font-weight: 700; }

/* ==================== 快速指标 ==================== */
.quick-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.stat-item {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(72, 187, 120, 0.12);
  display: flex;
  align-items: center;
  gap: 20rpx;
  opacity: 0;
  transform: translateY(20rpx);
  animation: fadeInUp 0.45s ease forwards;
}
@keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }

.stat-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(72, 187, 120, 0.08);
  box-shadow: inset 0 0 0 2rpx rgba(72, 187, 120, 0.12);
}
.stat-icon-1 { background: rgba(72, 187, 120, 0.10); }
.stat-icon-2 { background: rgba(237, 137, 54, 0.10); }
.stat-icon-3 { background: rgba(100, 116, 139, 0.10); }
.stat-emoji { font-size: 34rpx; }

.stat-content { flex: 1; min-width: 0; }
.stat-name { display: block; font-size: 24rpx; color: var(--slate-600); }
.stat-value { display: block; font-size: 32rpx; font-weight: 700; color: var(--slate-900); margin-top: 6rpx; }

.stat-trend {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  box-shadow: inset 0 0 0 2rpx #eef2f7;
}
.trend-good { color: var(--green); background: rgba(72, 187, 120, 0.10); box-shadow: none; }
.trend-neutral { color: var(--orange); background: rgba(237, 137, 54, 0.10); box-shadow: none; }
.trend-bad { color: var(--red); background: rgba(245, 101, 101, 0.10); box-shadow: none; }

/* ==================== 简单卡片头 ==================== */
.card-header-simple {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx 12rpx 32rpx;
}
.header-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: rgba(72, 187, 120, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-emoji { font-size: 32rpx; }
.header-title { font-size: 30rpx; font-weight: 700; color: var(--slate-900); }

/* ==================== 器官简介 ==================== */
.info-card { overflow: hidden; }
.intro-content {
  display: grid;
  grid-template-columns: 120rpx 1fr;
  gap: 24rpx;
  padding: 0 32rpx 28rpx;
  align-items: center;
}
.intro-visual { display: flex; align-items: center; justify-content: center; }
.organ-illustration {
  width: 110rpx;
  height: 110rpx;
  border-radius: 28rpx;
  background: radial-gradient(circle at 30% 20%, rgba(72, 187, 120, 0.2), rgba(72, 187, 120, 0.05));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(72, 187, 120, 0.12);
}
.intro-text { font-size: 26rpx; line-height: 1.7; color: var(--slate-600); }

/* ==================== 健康趋势 ==================== */
.trend-card { overflow: hidden; }
.trend-card .card-header-simple { padding-bottom: 0; }
.header-action { margin-left: auto; padding: 8rpx 12rpx; border-radius: 12rpx; background: rgba(72, 187, 120, 0.08); }
.header-action:active { transform: scale(0.96); }

.trend-content { padding: 24rpx 32rpx 28rpx; }
.trend-canvas { width: 100%; height: 240rpx; border-radius: 16rpx; background: #ffffff; display: block; }

.trend-labels {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-wrap: wrap;
}
.trend-label-item { display: inline-flex; align-items: center; gap: 10rpx; }
.label-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.dot-min { background: #86efac; }
.dot-avg { background: #34d399; }
.dot-max { background: #10b981; }
.label-text { font-size: 24rpx; color: var(--slate-600); }

/* ==================== 每日小贴士 ==================== */
.tip-card { display: flex; gap: 20rpx; align-items: center; padding: 28rpx 32rpx; }
.tip-icon-large {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: rgba(72, 187, 120, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.tip-content { flex: 1; }
.tip-title { display: block; font-size: 28rpx; font-weight: 700; color: var(--slate-900); margin-bottom: 6rpx; }
.tip-text { display: block; font-size: 26rpx; color: var(--slate-600); line-height: 1.7; }

/* ==================== 详细指标 ==================== */
.metrics-card { overflow: hidden; }
.metrics-list { padding: 8rpx 16rpx 20rpx; }

.metric-item {
  margin: 16rpx;
  border-radius: 28rpx;
  border: 2rpx solid rgba(72, 187, 120, 0.12);
  background: #ffffff;
  overflow: hidden;
  transition: box-shadow .2s, transform .2s;
  position: relative;
}
.metric-item:active { transform: scale(0.995); }

.metric-main { padding: 28rpx; }
.metric-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.metric-title-row { display: flex; align-items: center; gap: 12rpx; }
.metric-name { font-size: 28rpx; font-weight: 700; color: var(--slate-900); }
.metric-status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.status-good { background: var(--green); }
.status-neutral { background: var(--orange); }
.status-bad { background: var(--red); }

.metric-value-large { font-size: 34rpx; font-weight: 800; color: var(--slate-800); }

.metric-progress { display: flex; align-items: center; gap: 16rpx; }
.progress-track {
  position: relative;
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f1f5f9;
  box-shadow: inset 0 0 0 2rpx #eef2f7;
}
.progress-fill {
  height: 100%;
  border-radius: inherit;
  position: relative;
  transition: width .35s ease;
}
.fill-good { background: linear-gradient(90deg, #86efac, #22c55e); }
.fill-neutral { background: linear-gradient(90deg, #fed7aa, #fb923c); }
.fill-bad { background: linear-gradient(90deg, #fecaca, #ef4444); }
.progress-shine {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(90deg, rgba(255,255,255,.0), rgba(255,255,255,.35), rgba(255,255,255,0));
  transform: translateX(-100%);
  animation: shine 2.2s infinite;
}
@keyframes shine { 0% { transform: translateX(-100%);} 60%,100% { transform: translateX(100%);} }
.progress-text { width: 88rpx; text-align: right; font-size: 24rpx; color: var(--slate-600); }

.metric-expand { border-top: 2rpx solid #f1f5f9; background: #fcfffd; }
.expand-content { padding: 24rpx 28rpx; }
.expand-label { display: block; font-size: 24rpx; font-weight: 700; color: var(--slate-800); margin-bottom: 8rpx; }
.expand-text { display: block; font-size: 26rpx; color: var(--slate-600); line-height: 1.7; }

.expand-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }
.action-btn {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  border: none;
}
.primary-action { background: var(--green); color: #fff; }
.secondary-action { background: rgba(72, 187, 120, 0.10); color: var(--green); }

.metric-toggle {
  position: absolute;
  right: 22rpx;
  bottom: 18rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ==================== 改善建议 ==================== */
.suggestions-list { padding: 8rpx 16rpx 20rpx; }
.suggestion-item {
  margin: 16rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  border: 2rpx solid #eef2f7;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 18rpx;
  transition: transform .15s;
}
.suggestion-item:active { transform: scale(0.995); }

.suggestion-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.food-badge { background: rgba(34, 197, 94, 0.12); }
.exercise-badge { background: rgba(59, 130, 246, 0.12); }
.lifestyle-badge { background: rgba(234, 179, 8, 0.12); }
.badge-emoji { font-size: 34rpx; }

.suggestion-content { flex: 1; min-width: 0; }
.suggestion-title { display: block; font-size: 28rpx; font-weight: 700; color: var(--slate-900); }
.suggestion-desc { display: block; font-size: 26rpx; color: var(--slate-600); margin-top: 6rpx; }
.suggestion-arrow { width: 44rpx; height: 44rpx; border-radius: 50%; background: #f8fafc; display: flex; align-items: center; justify-content: center; }

/* ==================== 推荐食物 ==================== */
.foods-card { overflow: hidden; }
.foods-scroll { padding: 4rpx 8rpx 28rpx; }
.foods-list { display: flex; flex-direction: row; gap: 18rpx; padding: 0 24rpx; }

.food-card {
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(2, 6, 23, 0.06);
  transition: transform .18s;
  width: 420rpx;
}
.food-card:active { transform: scale(0.98); }

.food-image-wrapper { position: relative; height: 220rpx; overflow: hidden; }
.food-image { width: 100%; height: 100%; display: block; }
.food-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(to top, rgba(2, 6, 23, .45), rgba(2, 6, 23, 0));
}

.food-info {
  position: absolute;
  left: 20rpx;
  bottom: 16rpx;
  right: 20rpx;
  z-index: 2;
  color: #ffffff;
}
.food-name { display: block; font-size: 28rpx; font-weight: 800; text-shadow: 0 2rpx 6rpx rgba(0,0,0,.25); }
.food-benefit { display: block; font-size: 24rpx; opacity: 0.9; }

/* ==================== AI 个性化计划 ==================== */
.ai-card { overflow: hidden; padding: 28rpx 28rpx 32rpx; }
.ai-header { display: flex; align-items: center; gap: 18rpx; margin-bottom: 8rpx; }
.ai-icon-wrapper { position: relative; width: 68rpx; height: 68rpx; border-radius: 20rpx; background: rgba(72, 187, 120, 0.12); display: flex; align-items: center; justify-content: center; }
.ai-icon { font-size: 34rpx; }
.ai-pulse {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 20rpx;
  box-shadow: 0 0 0 0 rgba(72, 187, 120, 0.35);
  animation: pulse 2.2s infinite;
}
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(72, 187, 120, 0.35); }
  70% { box-shadow: 0 0 0 24rpx rgba(72, 187, 120, 0); }
  100% { box-shadow: 0 0 0 0 rgba(72, 187, 120, 0); }
}

.ai-title-section { display: flex; flex-direction: column; }
.ai-title { font-size: 30rpx; font-weight: 800; color: var(--slate-900); }
.ai-subtitle { font-size: 24rpx; color: var(--slate-500); margin-top: 4rpx; }

.ai-content { margin-top: 10rpx; }
.ai-plan-text { font-size: 26rpx; color: var(--slate-700); line-height: 1.8; }

.ai-generate-btn {
  margin-top: 20rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 22rpx;
  border-radius: 999rpx;
  background: var(--green);
  color: #fff;
  font-weight: 800;
  border: none;
  position: relative;
  overflow: hidden;
}
.ai-generate-btn:active { transform: scale(0.99); }
.btn-shine {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(120deg, rgba(255,255,255,.0) 30%, rgba(255,255,255,.25) 50%, rgba(255,255,255,.0) 70%);
  transform: translateX(-100%);
  animation: btnShine 3s ease-in-out infinite;
}
@keyframes btnShine { 0% { transform: translateX(-100%);} 50% { transform: translateX(100%);} 100% { transform: translateX(100%);} }

/* ==================== 成就徽章 ==================== */
.achievements-card { overflow: hidden; padding-bottom: 24rpx; }
.achievements-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 8rpx 24rpx 24rpx;
}
.achievement-badge {
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  border-radius: 24rpx;
  border: 2rpx solid #eef2f7;
  padding: 18rpx 12rpx;
  text-align: center;
}
.badge-icon { font-size: 34rpx; margin-bottom: 8rpx; }
.trophy-icon { font-size: 36rpx; }
.badge-text { display: block; font-size: 24rpx; color: var(--slate-700); }

/* ==================== 底部操作栏 ==================== */
.footer-actions {
  background: linear-gradient(180deg, #ffffff 0%, #f8fffb 100%);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 28rpx;
}
.footer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 22rpx 0;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 800;
  border: none;
}
.primary-btn { background: var(--green); color: #fff; }
.secondary-btn { background: rgba(72, 187, 120, 0.10); color: var(--green); }

.safe-bottom { width: 100%; }

/* ==================== 成功动画遮罩 ==================== */
.success-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2000;
  background: rgba(2, 6, 23, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}
.success-content {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 20rpx 60rpx rgba(2, 6, 23, 0.2);
  animation: pop .28s ease;
}
@keyframes pop { from { transform: scale(.96); opacity: .8;} to { transform: scale(1); opacity: 1;} }
.success-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--green);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
}
.success-text { font-size: 28rpx; font-weight: 700; color: var(--slate-800); }

/* ==================== 响应式优化 ==================== */
@media (max-width: 750px) {
  .quick-stats { grid-template-columns: 1fr 1fr; }
  .achievements-grid { grid-template-columns: 1fr 1fr; }
  .intro-content { grid-template-columns: 1fr; text-align: left; }
  .hero-content { padding: 40rpx 36rpx; }
  .trend-canvas { height: 220rpx; }
}

/* ==================== 兼容/细节增强 ==================== */
button { -webkit-tap-highlight-color: transparent; }

