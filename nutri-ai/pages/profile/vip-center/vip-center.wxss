.page {
  min-height: 100vh;
  background: radial-gradient(1000rpx 680rpx at 18% -10%, rgba(99, 102, 241, 0.18), rgba(255, 255, 255, 0) 60%),
    radial-gradient(900rpx 520rpx at 90% 0%, rgba(34, 197, 94, 0.14), rgba(255, 255, 255, 0) 55%),
    #f6f8ff;
  padding-bottom: calc(env(safe-area-inset-bottom) + 170rpx);
}

.hero {
  position: relative;
  padding: 28rpx 24rpx 18rpx;
  border-bottom-left-radius: 34rpx;
  border-bottom-right-radius: 34rpx;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(255, 214, 0, 0.78) 0%, rgba(255, 153, 0, 0.62) 100%);
  box-shadow: 0 22rpx 70rpx rgba(249, 115, 22, 0.18);
}

.hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
  opacity: 0.95;
}

.orb1 {
  width: 560rpx;
  height: 560rpx;
  left: -280rpx;
  top: -260rpx;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.60), rgba(255, 255, 255, 0) 65%);
}

.orb2 {
  width: 480rpx;
  height: 480rpx;
  right: -220rpx;
  top: -200rpx;
  background: radial-gradient(circle at 40% 40%, rgba(59, 130, 246, 0.24), rgba(255, 255, 255, 0) 70%);
}

.shine {
  position: absolute;
  left: -20%;
  top: -30%;
  width: 60%;
  height: 160%;
  transform: rotate(18deg);
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.30) 50%, rgba(255, 255, 255, 0) 100%);
  opacity: 0.55;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-left {
  flex: 1;
  min-width: 0;
}

.greeting {
  font-size: 36rpx;
  font-weight: 1000;
  color: rgba(15, 23, 42, 0.88);
  display: block;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(15, 23, 42, 0.64);
  display: block;
}

.badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  background: rgba(255, 255, 255, 0.52);
  flex-shrink: 0;
}

.badge.vip {
  background: rgba(255, 255, 255, 0.58);
}

.badge.normal {
  background: rgba(255, 255, 255, 0.46);
}

.badge-text {
  font-size: 24rpx;
  font-weight: 1000;
  color: rgba(15, 23, 42, 0.78);
  white-space: nowrap;
}

.profile-card {
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.86);
  border-radius: 28rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  position: relative;
  z-index: 1;
  border: 1rpx solid rgba(255, 255, 255, 0.48);
  box-shadow: 0 18rpx 70rpx rgba(15, 23, 42, 0.10);
}

.profile-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 14rpx 40rpx rgba(15, 23, 42, 0.08);
  flex-shrink: 0;
}

.avatar-text {
  font-size: 34rpx;
  font-weight: 1000;
  color: rgba(15, 23, 42, 0.82);
}

.profile-meta {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 1000;
  color: #0f172a;
  display: block;
}

.meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
  font-weight: 800;
  display: block;
  line-height: 1.5;
}

.ghost-btn {
  padding: 14rpx 18rpx;
  background: rgba(15, 23, 42, 0.06);
  border-radius: 18rpx;
  color: rgba(15, 23, 42, 0.86);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.ghost-btn::after {
  border: none;
}

.section {
  padding: 18rpx 24rpx 0;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 18rpx 0 14rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 1000;
  color: #0f172a;
}

.section-subtitle {
  font-size: 22rpx;
  font-weight: 800;
  color: #64748b;
  flex: 1;
  text-align: right;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-link {
  font-size: 22rpx;
  font-weight: 900;
  color: #2563eb;
  white-space: nowrap;
}

.card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 26rpx;
  border: 2rpx solid rgba(148, 163, 184, 0.12);
  box-shadow: 0 16rpx 70rpx rgba(15, 23, 42, 0.06);
  padding: 20rpx;
}

.health-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.health-left {
  flex: 1;
  min-width: 0;
}

.health-title {
  font-size: 28rpx;
  font-weight: 1000;
  color: #0f172a;
  display: block;
}

.health-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
  font-weight: 800;
  display: block;
  line-height: 1.5;
}

.health-level {
  font-size: 22rpx;
  font-weight: 1000;
  color: rgba(15, 23, 42, 0.72);
  padding: 10rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.06);
  white-space: nowrap;
}

.progress-wrap {
  margin-top: 16rpx;
}

.progress-track {
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.16);
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.92) 0%, rgba(59, 130, 246, 0.88) 100%);
}

.progress-text {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 900;
  color: rgba(15, 23, 42, 0.74);
  display: block;
}

.goal-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.goal {
  background: rgba(15, 23, 42, 0.04);
  border-radius: 20rpx;
  padding: 16rpx 14rpx;
}

.goal-value {
  font-size: 28rpx;
  font-weight: 1000;
  color: #0f172a;
  display: block;
}

.goal-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #64748b;
  display: block;
}

.plan-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.plan-left {
  flex: 1;
  min-width: 0;
}

.plan-title {
  font-size: 28rpx;
  font-weight: 1000;
  color: #0f172a;
  display: block;
}

.plan-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #64748b;
  display: block;
  line-height: 1.5;
}

.plan-chip {
  padding: 10rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 214, 0, 0.24);
  color: rgba(15, 23, 42, 0.80);
  font-size: 22rpx;
  font-weight: 1000;
  white-space: nowrap;
}

.plan-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.plan-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 14rpx;
  border-radius: 22rpx;
  background: rgba(15, 23, 42, 0.04);
}

.plan-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.plan-texts {
  flex: 1;
  min-width: 0;
}

.plan-item-title {
  font-size: 24rpx;
  font-weight: 1000;
  color: rgba(15, 23, 42, 0.82);
  display: block;
}

.plan-item-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #64748b;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-item-tag {
  font-size: 20rpx;
  font-weight: 900;
  color: rgba(15, 23, 42, 0.70);
  white-space: nowrap;
}

.plan-actions {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
}

.primary-btn {
  flex: 1;
  padding: 18rpx 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(15, 23, 42, 0.92) 0%, rgba(30, 41, 59, 0.92) 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 1000;
  line-height: 1;
}

.primary-btn::after {
  border: none;
}

.secondary-btn {
  flex: 1;
  padding: 18rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.06);
  color: rgba(15, 23, 42, 0.84);
  font-size: 26rpx;
  font-weight: 1000;
  line-height: 1;
}

.secondary-btn::after {
  border: none;
}

.achievements {
  width: 100%;
}

.ach-row {
  display: flex;
  gap: 12rpx;
  padding-right: 24rpx;
}

.ach-card {
  width: 320rpx;
  padding: 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(148, 163, 184, 0.12);
  box-shadow: 0 16rpx 70rpx rgba(15, 23, 42, 0.06);
}

.ach-card.on {
  border-color: rgba(16, 185, 129, 0.18);
}

.ach-title {
  font-size: 26rpx;
  font-weight: 1000;
  color: rgba(15, 23, 42, 0.86);
  display: block;
}

.ach-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #64748b;
  display: block;
  line-height: 1.5;
}

.ach-pill {
  margin-top: 14rpx;
  padding: 10rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.06);
  color: rgba(15, 23, 42, 0.78);
  font-size: 22rpx;
  font-weight: 1000;
  display: inline-block;
}

.rec-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rec-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.rec-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.rec-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 14rpx;
  box-shadow: 0 10rpx 34rpx rgba(15, 23, 42, 0.10);
  flex-shrink: 0;
}

.rec-texts {
  flex: 1;
  min-width: 0;
}

.rec-title {
  font-size: 26rpx;
  font-weight: 1000;
  color: rgba(15, 23, 42, 0.86);
  display: block;
}

.rec-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #64748b;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rec-action {
  font-size: 22rpx;
  font-weight: 900;
  color: rgba(15, 23, 42, 0.74);
  white-space: nowrap;
}

.rec-arrow {
  font-size: 34rpx;
  color: rgba(15, 23, 42, 0.38);
  line-height: 1;
}

.bottom-space {
  height: 20rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(env(safe-area-inset-bottom) + 18rpx);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid rgba(148, 163, 184, 0.25);
}

.bottom-left {
  flex: 1;
  min-width: 0;
}

.bottom-title {
  font-size: 28rpx;
  font-weight: 1000;
  color: rgba(15, 23, 42, 0.86);
  display: block;
}

.bottom-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #64748b;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cta-btn {
  min-width: 280rpx;
  padding: 22rpx 26rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(15, 23, 42, 0.92) 0%, rgba(30, 41, 59, 0.92) 100%);
  color: #ffffff;
  box-shadow: 0 22rpx 90rpx rgba(15, 23, 42, 0.26);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.cta-btn::after {
  border: none;
}

.cta-btn:active {
  transform: scale(0.985);
  box-shadow: 0 16rpx 70rpx rgba(15, 23, 42, 0.22);
}

.cta-shine {
  position: absolute;
  top: -40%;
  left: -60%;
  width: 70%;
  height: 220%;
  transform: rotate(18deg);
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.22) 50%, rgba(255, 255, 255, 0) 100%);
  opacity: 0.7;
}

.cta-text {
  font-size: 30rpx;
  font-weight: 1000;
  line-height: 1.05;
  position: relative;
  z-index: 1;
}

.cta-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.78);
  position: relative;
  z-index: 1;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

