/* 页面容器 */
.profile-container {
  padding: 20rpx 30rpx;
  padding-top: calc(env(safe-area-inset-top) + 44px + 16rpx);
  background: linear-gradient(180deg, #ecfeff 0%, #ffffff 55%, #f8fafc 100%);
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx);
}

/* ==================== 顶部用户信息区域 ==================== */
.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.avatar-section {
  position: relative;
  margin-right: 24rpx;
}

.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #14b8a6, #0ea5e9);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(14, 165, 233, 0.35);
}

.edit-icon {
  width: 22rpx;
  height: 22rpx;
}

.user-info {
  flex: 1;
}

.username-line {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  margin-right: 12rpx;
}

.vip-badge {
  width: 48rpx;
  height: 48rpx;
}

.kcoin-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
}

.kcoin-icon {
  width: 28rpx;
  height: 28rpx;
}

.kcoin-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #0f172a;
  background: rgba(255, 255, 255, 0.85);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.06);
}

.icon-img {
  width: 28rpx;
  height: 28rpx;
}

.settings-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.08);
}

.settings-btn .icon-img {
  width: 32rpx;
  height: 32rpx;
}

/* ==================== VIP会员卡 ==================== */
.vip-card {
  background: linear-gradient(135deg, #14b8a6 0%, #0ea5e9 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 12rpx 34rpx rgba(14, 165, 233, 0.25);
  position: relative;
  overflow: hidden;
}

.vip-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.vip-card-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.vip-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.vip-info {
  flex: 1;
}

.vip-title-line {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.vip-title {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
}

.vip-status {
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.95);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
}

.vip-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.vip-action-btn {
  background: #ffffff;
  color: #0f172a;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.arrow-icon {
  width: 20rpx;
  height: 20rpx;
  margin-left: 8rpx;
}

/* ==================== K币积分卡片 ==================== */
.assets-card {
  background: linear-gradient(135deg, #0ea5e9 0%, #14b8a6 55%, #6366f1 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  color: #ffffff;
  margin-bottom: 30rpx;
  box-shadow: 0 18rpx 70rpx rgba(15, 23, 42, 0.14);
  position: relative;
  overflow: hidden;
}

.assets-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 85% 25%, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 48%),
    radial-gradient(circle at 12% 88%, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 45%),
    radial-gradient(circle at 35% 10%, rgba(15, 23, 42, 0.16) 0%, rgba(15, 23, 42, 0) 55%);
  opacity: 0.9;
  pointer-events: none;
}

.assets-card::after {
  content: '';
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 44rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0));
  transform: rotate(18deg);
  opacity: 0.9;
  pointer-events: none;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.card-title {
  font-size: 28rpx;
  display: flex;
  align-items: center;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.92);
}

.money-balance {
  display: flex;
  align-items: baseline;
}

.money {
  font-size: 52rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 1rpx;
  text-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.18);
}

.wallet-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  position: relative;
  z-index: 1;
}

.wallet-name {
  font-size: 28rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.95);
}

.wallet-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.wallet-arrow {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.9;
  filter: brightness(200%);
}

/* ==================== 订单/收藏快捷卡片 ==================== */
.quick-actions-card {
  background: #ffffff;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 24rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 16rpx 60rpx rgba(15, 23, 42, 0.06);
  display: flex;
  align-items: stretch;
}

.quick-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 110rpx;
}

.quick-action-texts {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.quick-action-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
}

.quick-action-sub {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 700;
}

.quick-action-divider {
  width: 2rpx;
  background: rgba(15, 23, 42, 0.08);
  margin: 6rpx 18rpx;
}

.quick-action-icon-slot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: rgba(15, 23, 42, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.quick-action-icon {
  width: 44rpx;
  height: 44rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.more {
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
}

.exchange-scroll {
  white-space: nowrap;
  margin: 0 -28rpx;
  padding: 0 28rpx;
}

.exchange-item {
  display: inline-block;
  width: 180rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #eef2f7 100%);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  margin-right: 20rpx;
  text-align: center;
  vertical-align: top;
}

.exchange-item:last-child {
  margin-right: 0;
}

.exchange-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
}

.exchange-name {
  display: block;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
  white-space: normal;
  word-break: break-all;
}

.exchange-cost {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #667eea;
  font-weight: 700;
}

.coin-mini {
  width: 28rpx;
  height: 28rpx;
  margin-right: 4rpx;
}

/* ==================== 健康数据概览 ==================== */
.health-overview {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.health-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  display: flex;
  align-items: center;
  flex-direction: column;
}

.stat-texts {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #0ea5e9;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #f0f0f0;
}

/* ==================== 纵向菜单列表 ==================== */
.profile-menu {
  background: #ffffff;
  border-radius: 24rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 16rpx 60rpx rgba(15, 23, 42, 0.06);
  overflow: hidden;
  margin-bottom: 30rpx;
}

.menu-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
}

.menu-arrow {
  font-size: 34rpx;
  color: #cbd5e1;
  line-height: 1;
  font-weight: 700;
}

.menu-divider {
  height: 2rpx;
  background: rgba(15, 23, 42, 0.06);
  margin-left: 28rpx;
}
