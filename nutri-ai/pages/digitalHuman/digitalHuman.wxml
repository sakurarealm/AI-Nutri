<proactive-notification id="proactive-notification" />
<view class="page">
  <view class="bg">
    <view class="bg-orb orb1"></view>
    <view class="bg-orb orb2"></view>
  </view>

  <view class="nav" style="padding-top: {{navPaddingTopPx}}px; padding-right: {{navRightPaddingPx}}px; height: {{navHeightPx}}px;">
    <view class="nav-left">
      <text class="title">健康空间</text>
      <text class="sub">{{dateLabel}} · {{presenceLine}}</text>
    </view>
    <view class="nav-right">
      <view class="ai-btn" bindtap="goAiAgent">问AI</view>
    </view>
  </view>

  <view class="content" style="padding-top: {{contentPaddingTopPx}}px;">
    <view class="tab-switch">
      <view class="tab-item {{viewIndex === 0 ? 'active' : ''}}" data-index="0" bindtap="onViewSwitch">今天</view>
      <view class="tab-item {{viewIndex === 1 ? 'active' : ''}}" data-index="1" bindtap="onViewSwitch">本周</view>
      <view class="tab-item {{viewIndex === 2 ? 'active' : ''}}" data-index="2" bindtap="onViewSwitch">人群</view>
      <view class="underline" style="transform: translateX({{viewIndex * 100}}%);"></view>
    </view>

    <view class="hero-section">
      <text class="label">整体完成率</text>
      <view class="value-wrapper">
        <text class="value">{{completionRate}}</text>
        <text class="percent">%</text>
      </view>
      <text class="hint">{{completionHint}}</text>
      <view class="motto-wrapper {{showMotto ? 'visible' : ''}}">
        <text class="motto">{{currentMotto}}</text>
      </view>
    </view>

    <view class="progress-bar">
      <view class="fill" style="width: {{completionRate}}%;"></view>
    </view>
    <view class="progress-labels">
      <text class="left">{{barLeft}}</text>
      <text class="right">{{barRight}}</text>
    </view>

    <view class="metrics-grid">
      <view class="metric-item">
        <text class="value">{{streakDays}}</text>
        <text class="label">连续达标天数</text>
      </view>
      <view class="metric-item">
        <text class="value">{{warmScore}}</text>
        <text class="label">温柔指数</text>
      </view>
    </view>

    <view class="achievements-section">
      <text class="title">大家今天的温柔瞬间</text>
      <scroll-view class="achievements-scroll" scroll-x enhanced show-scrollbar="false">
        <view class="achievements-list">
          <view class="achievement-item" wx:for="{{achievements}}" wx:key="id">
            <text class="icon">{{item.icon}}</text>
            <text class="text">{{item.text}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="pulse-section">
      <text class="title">陪伴脉搏</text>
      <text class="sub">{{pulseSubtitle}}</text>
      <view class="pulse-grid {{pulseAnimate ? 'animate' : ''}}">
        <view class="item">
          <text class="value">{{pulse.reached}}</text>
          <text class="label">今日达标人数</text>
        </view>
        <view class="item">
          <text class="value">{{pulse.stepsAvg}}</text>
          <text class="label">平均活跃度</text>
        </view>
        <view class="item">
          <text class="value">{{pulse.lightMealRate}}%</text>
          <text class="label">轻食比例</text>
        </view>
      </view>
    </view>

    <view class="timeline-section">
      <text class="title">健康时间轴</text>
      <text class="sub">系统与 AI 为你和大家记录的温柔瞬间</text>
      <view class="timeline-list">
        <view class="card {{item.badge === 'AI' ? 'ai' : item.badge === '系统' ? 'system' : 'anon'}}" 
              wx:for="{{timeline}}" wx:key="id" data-id="{{item.id}}" bindtap="onTimelineTap">
          <view class="header">
            <text class="time">{{item.time}}</text>
            <text class="badge">{{item.badge}}</text>
          </view>
          <text class="title">{{item.title}}</text>
          <text class="desc">{{item.desc}}</text>
          <view class="kv-list" wx:if="{{item.kv && item.kv.length}}">
            <view class="kv" wx:for="{{item.kv}}" wx:key="k">
              <text class="k">{{item.k}}：</text>
              <text class="v">{{item.v}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <custom-tabbar id="tabbar" />
</view>
