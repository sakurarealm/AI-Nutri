.page { min-height: 100vh; background: #fdfdff; }

.bg { position: fixed; inset: 0; pointer-events: none; }
.bg-orb { position: absolute; border-radius: 9999rpx; filter: blur(100rpx); opacity: 0.22; animation: breathe 20s ease-in-out infinite; }
.orb1 { width: 680rpx; height: 680rpx; left: -240rpx; top: -120rpx; background: radial-gradient(circle, rgba(20,184,166,0.18), transparent 68%); }
.orb2 { width: 760rpx; height: 760rpx; right: -280rpx; bottom: -180rpx; background: radial-gradient(circle, rgba(14,165,233,0.16), transparent 70%); }
@keyframes breathe {
  0%, 100% { transform: scale(1) translate(0, 0); }
  50% { transform: scale(1.08) translate(20rpx, -20rpx); }
}

.nav { position: fixed; top: 0; left: 0; right: 0; padding-left: 48rpx; padding-right: 48rpx; padding-bottom: 95rpx; backdrop-filter: blur(18rpx); background: rgba(253,253,255,0.72); z-index: 30; display: flex; justify-content: space-between; align-items: center; box-sizing: border-box; border-bottom: 1rpx solid rgba(15,23,42,0.06); }
.title { font-size: 44rpx; font-weight: 900; color: #0f172a; }
.sub { margin-top: 8rpx; font-size: 26rpx; color: #64748b; display: block; }
.nav-right { margin-top: 10rpx; }
.ai-btn { font-size: 24rpx; font-weight: 800; color: #0f172a; padding: 8rpx 22rpx; border-radius: 999rpx; background: rgba(15,23,42,0.035); }

.content { padding-left: 48rpx; padding-right: 48rpx; padding-bottom: calc(constant(safe-area-inset-bottom) + 200rpx); padding-bottom: calc(env(safe-area-inset-bottom) + 200rpx); box-sizing: border-box; }

.tab-switch { position: relative; display: flex; height: 88rpx; padding-bottom: 18rpx; box-sizing: border-box; align-items: center; justify-content: space-around; font-size: 36rpx; font-weight: 700; color: #94a3b8; overflow: hidden; }
.tab-item.active { color: #0f172a; }
.underline { position: absolute; bottom: 10rpx; left: 0; width: 33.33%; height: 4rpx; background: rgba(15,23,42,0.22); border-radius: 999rpx; transition: transform 320ms ease; }

.hero-section { margin-top: 100rpx; text-align: center; }
.label { font-size: 28rpx; color: #64748b; letter-spacing: 6rpx; }
.value-wrapper { margin: 40rpx 0; }
.value { font-size: 160rpx; font-weight: 900; color: #0f172a; line-height: 1; }
.percent { font-size: 80rpx; color: #64748b; }
.hint { font-size: 32rpx; color: #475569; line-height: 1.6; }

.motto-wrapper { margin-top: 60rpx; height: 80rpx; overflow: hidden; }
.motto { font-size: 36rpx; color: #64748b; letter-spacing: 4rpx; font-weight: 600; opacity: 0; transform: translateY(20rpx); transition: all 800ms ease; }
.motto-wrapper.visible .motto { opacity: 1; transform: translateY(0); }

.progress-bar { height: 6rpx; background: #e2e8f0; border-radius: 3rpx; overflow: hidden; margin-top: 100rpx; position: relative; }
.fill { height: 100%; background: linear-gradient(90deg, #cbd5e1, #94a3b8); transition: width 900ms ease; }
.fill::after { content: ''; position: absolute; top: 0; left: -100%; width: 60%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent); animation: shimmer 4s infinite; }
@keyframes shimmer { 0% { left: -100%; } 100% { left: 100%; } }

.progress-labels { margin-top: 32rpx; display: flex; justify-content: space-between; font-size: 28rpx; color: #64748b; font-weight: 600; }

.metrics-grid { margin-top: 120rpx; display: flex; justify-content: center; gap: 120rpx; }
.metric-item .value { font-size: 72rpx; font-weight: 900; color: #0f172a; }
.metric-item .label { margin-top: 16rpx; font-size: 26rpx; color: #64748b; text-align: center; }

.achievements-section { margin-top: 140rpx; }
.achievements-section .title { font-size: 42rpx; font-weight: 900; color: #0f172a; }
.achievements-scroll { white-space: nowrap; margin-top: 40rpx; }
.achievements-list { display: inline-flex; gap: 32rpx; padding: 0 48rpx; }
.achievement-item { flex-shrink: 0; background: #f8fafc; border-radius: 40rpx; padding: 24rpx 40rpx; display: flex; align-items: center; gap: 20rpx; box-shadow: 0 10rpx 30rpx rgba(15,23,42,0.04); }
.achievement-item .icon { font-size: 48rpx; }
.achievement-item .text { font-size: 28rpx; color: #475569; font-weight: 600; }

.pulse-section, .timeline-section { margin-top: 140rpx; }
.title { font-size: 42rpx; font-weight: 900; color: #0f172a; }
.sub { margin-top: 20rpx; font-size: 28rpx; color: #64748b; line-height: 1.6; }

.pulse-grid { margin-top: 80rpx; display: flex; justify-content: space-between; text-align: center; }
.pulse-grid .item .value { font-size: 60rpx; font-weight: 900; color: #0f172a; display: inline-block; }
.pulse-grid.animate .item .value { animation: pulseAnimate 800ms ease forwards; }
@keyframes pulseAnimate {
  0% { transform: scale(0.8); opacity: 0; }
  70% { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}
.pulse-grid .item .label { margin-top: 16rpx; font-size: 26rpx; color: #64748b; }

.timeline-list { margin-top: 80rpx; }
.card { background: #ffffff; border-radius: 48rpx; padding: 48rpx; margin-bottom: 48rpx; box-shadow: 0 20rpx 60rpx rgba(15,23,42,0.04); position: relative; overflow: hidden; transition: transform 200ms ease, box-shadow 200ms ease; opacity: 0; animation: fadeUp 600ms ease forwards; }
.card:nth-child(1) { animation-delay: 100ms; }
.card:nth-child(2) { animation-delay: 300ms; }
.card:nth-child(3) { animation-delay: 500ms; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(40rpx); } to { opacity: 1; transform: none; } }

.card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 8rpx; opacity: 0.3; }
.card.ai::before { background: linear-gradient(90deg, #34d399, #10b981); }
.card.system::before { background: linear-gradient(90deg, #94a3b8, #64748b); }
.card.anon::before { background: linear-gradient(90deg, #e2e8f0, #cbd5e1); }

.card:active { transform: scale(0.98); box-shadow: 0 30rpx 80rpx rgba(15,23,42,0.12); }

.header { display: flex; justify-content: space-between; align-items: center; }
.time { font-size: 26rpx; color: #94a3b8; }
.badge { font-size: 22rpx; padding: 8rpx 24rpx; background: #f8fafc; border-radius: 999rpx; color: #475569; font-weight: 600; }

.card .title { margin-top: 28rpx; font-size: 40rpx; font-weight: 900; color: #0f172a; line-height: 1.4; }
.card .desc { margin-top: 20rpx; font-size: 30rpx; color: #475569; line-height: 1.65; }

.kv-list { margin-top: 40rpx; display: flex; flex-wrap: wrap; gap: 32rpx; }
.kv .k { font-size: 26rpx; color: #64748b; }
.kv .v { font-size: 28rpx; font-weight: 700; color: #0f172a; }
