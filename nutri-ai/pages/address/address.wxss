.page {
  min-height: 100vh;
  background: #f8fafc;
  padding: 22rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.header {
  padding: 10rpx 6rpx 18rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 900;
  color: #0f172a;
  display: block;
}

.sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #94a3b8;
  display: block;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  background: #ffffff;
  border-radius: 26rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 18rpx 70rpx rgba(15, 23, 42, 0.08);
  padding: 18rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  box-sizing: border-box;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.top-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.phone {
  font-size: 24rpx;
  font-weight: 900;
  color: #64748b;
  flex-shrink: 0;
}

.addr {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #334155;
  line-height: 1.4;
  display: block;
  word-break: break-all;
}

.edit {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.10);
  background: rgba(15, 23, 42, 0.03);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.edit-icon {
  width: 32rpx;
  height: 32rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(248, 250, 252, 0.98);
  border-top: 2rpx solid rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.add-btn {
  height: 92rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #14b8a6, #0ea5e9);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn::after {
  border: none;
}
