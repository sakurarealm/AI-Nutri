.page {
  height: 100vh;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.map-section {
  height: 56vh;
  width: 100%;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.topbar {
  width: 100%;
}

.topbar-inner {
  height: 88rpx;
  padding: 14rpx 18rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

.nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 2rpx solid rgba(15, 23, 42, 0.10);
  color: #0f172a;
  font-size: 44rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-cta {
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.86);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pin {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -100%);
  width: 46rpx;
  height: 62rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pin-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #14b8a6, #0ea5e9);
  box-shadow: 0 16rpx 44rpx rgba(14, 165, 233, 0.35);
}

.pin-stick {
  width: 6rpx;
  height: 26rpx;
  margin-top: 6rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.25);
}

.panel {
  flex: 1;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  border-top: 2rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 -20rpx 70rpx rgba(15, 23, 42, 0.10);
  padding: 18rpx 18rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.pill {
  height: 78rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.10);
  background: rgba(248, 250, 252, 1);
  display: flex;
  align-items: center;
  overflow: hidden;
}

.pill-left {
  width: 250rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.pill-left-text {
  max-width: 180rpx;
  font-size: 24rpx;
  font-weight: 900;
  color: #0f172a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pill-left-arrow {
  font-size: 26rpx;
  font-weight: 900;
  color: #64748b;
}

.pill-divider {
  width: 2rpx;
  height: 46rpx;
  background: rgba(15, 23, 42, 0.10);
  flex-shrink: 0;
}

.pill-right {
  flex: 1;
  height: 78rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.pill-input {
  width: 100%;
  font-size: 24rpx;
  font-weight: 800;
  color: #0f172a;
}

.pill-placeholder {
  color: #94a3b8;
  font-weight: 800;
}

.nearby-head {
  margin-top: 18rpx;
  padding: 0 6rpx;
}

.nearby-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #0f172a;
}

.nearby-list {
  margin-top: 12rpx;
  border-top: 2rpx solid rgba(15, 23, 42, 0.06);
  height: 460rpx;
}

.nearby-item {
  padding: 18rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border-bottom: 2rpx solid rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.nearby-item.active {
  background: linear-gradient(135deg, rgba(20, 184, 166, 0.08), rgba(14, 165, 233, 0.08));
}

.nearby-main {
  flex: 1;
  min-width: 0;
}

.nearby-name {
  font-size: 28rpx;
  font-weight: 900;
  color: #0f172a;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nearby-addr {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #64748b;
  display: block;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nearby-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.10);
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 92rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #14b8a6, #0ea5e9);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn[disabled] {
  background: rgba(15, 23, 42, 0.14);
  color: rgba(15, 23, 42, 0.35);
}
