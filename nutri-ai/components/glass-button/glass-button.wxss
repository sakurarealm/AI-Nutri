.glass-button {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  outline: none;
  position: relative;
  overflow: hidden;
}

.glass-button:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.15);
}

.glass-button.send {
  background: linear-gradient(135deg, rgba(74, 222, 128, 0.2) 0%, rgba(34, 197, 94, 0.3) 100%);
  border: 1rpx solid rgba(34, 197, 94, 0.3);
  box-shadow: 0 4rpx 20rpx rgba(34, 197, 94, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

.glass-button.send:active {
  background: linear-gradient(135deg, rgba(74, 222, 128, 0.3) 0%, rgba(34, 197, 94, 0.4) 100%);
}

.button-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.8;
  transition: opacity 0.2s;
}

.glass-button.send .button-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 1;
}

.default-icon {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.default-icon::before,
.default-icon::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(255, 255, 255, 0.8);
  border-radius: 2rpx;
}

.default-icon::before {
  width: 20rpx;
  height: 4rpx;
}

.default-icon::after {
  width: 4rpx;
  height: 20rpx;
}