.smart-container {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 820;
}

.chips-drawer {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition: max-height 0.38s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  margin-bottom: 0;
}

.chips-drawer.open {
  max-height: 600rpx;
  opacity: 1;
  margin-bottom: 18rpx;
}

.chips-inner {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: center;
  padding: 8rpx 0;
}

.suggestion-chip {
  padding: 16rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  border: 1.5rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 6rpx 22rpx rgba(0, 0, 0, 0.08),
              inset 0 2rpx 6rpx rgba(255, 255, 255, 0.4);
  transform: translateY(24rpx) scale(0.88);
  opacity: 0;
  transition: all 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.chips-drawer.open .suggestion-chip {
  transform: translateY(0) scale(1);
  opacity: 1;
}

.suggestion-chip:active {
  transform: scale(0.94) !important;
  background: rgba(34, 197, 94, 0.12);
  border-color: rgba(34, 197, 94, 0.28);
}

.chip-text {
  font-size: 26rpx;
  color: #1a1a2e;
  font-weight: 500;
  line-height: 1.3;
}

.orb-wrapper {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.orb-glow {
  position: absolute;
  border-radius: 50%;
  opacity: 0;
  animation: orbPulse 2.8s ease-in-out infinite;
}

.glow-1 {
  width: 104rpx;
  height: 104rpx;
  background: radial-gradient(circle, rgba(34, 197, 94, 0.28), transparent 70%);
  animation-delay: 0s;
}

.glow-2 {
  width: 144rpx;
  height: 144rpx;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.2), transparent 70%);
  animation-delay: 0.6s;
}

.glow-3 {
  width: 184rpx;
  height: 184rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.14), transparent 70%);
  animation-delay: 1.2s;
}

@keyframes orbPulse {
  0%, 100% {
    opacity: 0;
    transform: scale(0.82);
  }
  35% {
    opacity: 0.4;
    transform: scale(0.94);
  }
  65% {
    opacity: 0.2;
    transform: scale(1);
  }
}

.orb-core {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4ade80 0%, #22c55e 40%, #16a34a 100%);
  box-shadow: 0 8rpx 28rpx rgba(34, 197, 94, 0.35),
              inset 0 3rpx 8rpx rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
              box-shadow 0.28s ease;
  position: relative;
}

.orb-core::after {
  content: '';
  position: absolute;
  inset: -4rpx;
  border-radius: 50%;
  background: conic-gradient(from 0deg, transparent, rgba(255, 255, 255, 0.5), transparent, rgba(255, 255, 255, 0.5), transparent);
  animation: orbSpin 4s linear infinite;
  opacity: 0.5;
  mask: radial-gradient(circle, transparent 60%, black 65%);
  -webkit-mask: radial-gradient(circle, transparent 60%, black 65%);
}

@keyframes orbSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.orb-core:active {
  transform: scale(0.9);
}

.orb-core.active {
  transform: scale(0.88);
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.25),
              inset 0 2rpx 6rpx rgba(255, 255, 255, 0.2);
}

.orb-icon {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 700;
  line-height: 1;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.orb-core.active .orb-icon {
  transform: rotate(90deg);
}
